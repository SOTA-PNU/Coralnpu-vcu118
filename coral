#!/usr/bin/env bash
# CoralNPU on VCU118 — one entry point for everything.
#
#   ./coral doctor            check tools, cable and serial port
#   ./coral setup             fetch upstream CoralNPU (pinned) and apply patches/
#   ./coral build             bitstream + boot ROM + hello.elf -> out/
#   ./coral resume            finish an interrupted build from Vivado's last checkpoint
#   ./coral sw                hello, rvv_test, matmul_bench ELFs + OpenOCD config -> out/
#   ./coral run <x.elf>       load over JTAG, run, print the console output
#   ./coral program [x.bit]   load the bitstream (Vivado batch)
#   ./coral load <x.elf>      load and run a program over JTAG (OpenOCD)
#   ./coral console           open the USB-UART console
#   ./coral up [x.bit]        program + wait for the ROM banner + run hello.elf
#   ./coral deploy [up]       copy out/ to the board host (fractal); "up" also runs
#                             "coral up" there (build in the licensed VM, run on fractal)
#   ./coral model <x.elf>     run a DDR-resident program (IREE model ELF) over JTAG
#                             and print its inference_* results (DDR4 bitstream)
#   ./coral ddr4-probe [synth] generate the DDR4 C1 controller IP only (minutes) and
#                             print its settings and ports -> out/ddr4_probe.txt;
#                             "synth" also checks every DDR pin gets placed (~20 min)
#
# Environment overrides: CONFIG, HW_SERVER, UART_DEV, BOARD_SSH* (see config.sh).
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/config.sh"

die()  { echo "ERROR: $*" >&2; exit 1; }
info() { echo "==> $*"; }

bazel_cmd() {
  if command -v bazelisk >/dev/null; then echo bazelisk; return; fi
  if command -v bazel >/dev/null; then echo bazel; return; fi
  local b="${TOOLS}/bazelisk"
  if [[ ! -x "${b}" ]]; then
    mkdir -p "${TOOLS}"
    info "downloading bazelisk to .tools/" >&2
    curl -fsSL -o "${b}" \
      https://github.com/bazelbuild/bazelisk/releases/download/v1.25.0/bazelisk-linux-amd64
    chmod +x "${b}"
  fi
  echo "${b}"
}

need_vivado() {
  command -v vivado >/dev/null ||
    die "vivado not on PATH. Run: source <Vivado install>/2026.1/Vivado/settings64.sh"
}

find_uart() {
  if [[ -n "${UART_DEV}" ]]; then echo "${UART_DEV}"; return; fi
  # CP2105 enumerates as two ttyUSB ports; by-id names contain "CP2105".
  # On the VCU118 the FPGA UART is interface 1 (if01); the ttyUSB number
  # changes between boots, the by-id name does not. (measured 2026-10-19)
  local d
  for d in /dev/serial/by-id/*CP2105*if01* /dev/serial/by-id/*CP2105*; do
    [[ -e "${d}" ]] && { readlink -f "${d}"; return; }
  done
  find /dev -maxdepth 1 -name "ttyUSB*" 2>/dev/null | sort | head -n1
}

# ---------------------------------------------------------------------------
cmd_doctor() {
  local ok=1
  check() { if eval "$2" >/dev/null 2>&1; then echo "  [ok]   $1"; else echo "  [miss] $1  -> $3"; ok=0; fi; }
  echo "tools:"
  check git            "command -v git"      "sudo apt install git"
  check curl           "command -v curl"     "sudo apt install curl"
  check readelf        "command -v readelf"  "sudo apt install binutils"
  check openocd        "command -v openocd"  "sudo apt install openocd"
  check vivado         "command -v vivado"   "source .../Vivado/settings64.sh"
  check "bazel(isk)"   "bazel_cmd"           "downloaded automatically on first build"
  echo "board:"
  check "USB-JTAG 0403:6014 (Digilent JTAG-SMT2-NC, J106)" "lsusb -d 0403:6014" \
        "cable on J106? VirtualBox: Devices > USB > Digilent"
  check "USB-UART CP2105 (J4)" "[[ -n \"\$(find_uart)\" ]]" \
        "cable on J4? VirtualBox: Devices > USB > Silicon Labs CP2105"
  echo "upstream:"
  check "work/coralnpu at ${CORALNPU_COMMIT:0:8} with patches" \
        "[[ -f '${WORK}/fpga/rtl/chip_vcu118.sv' ]]" "./coral setup"
  [[ ${ok} == 1 ]] && echo "all good" || echo "fix the [miss] lines above"
}

# ---------------------------------------------------------------------------
cmd_setup() {
  if [[ ! -d "${WORK}/.git" ]]; then
    info "cloning upstream CoralNPU"
    mkdir -p "$(dirname "${WORK}")"
    git clone --filter=blob:none "${CORALNPU_URL}" "${WORK}"
  fi
  cd "${WORK}"
  local head
  head="$(git rev-parse HEAD)"
  if [[ "${head}" != "${CORALNPU_COMMIT}" ]]; then
    if [[ -n "$(git status --porcelain)" ]]; then
      die "work/coralnpu has local changes; move them away or delete work/ and rerun"
    fi
    git fetch -q origin "${CORALNPU_COMMIT}" 2>/dev/null || git fetch -q origin
    git checkout -q --detach "${CORALNPU_COMMIT}"
  fi
  # Applied patches are recorded in .git/coral-applied (name + sha256): with
  # stacked patches a reverse-apply check of an early one fails once a later
  # one has touched the same lines.
  local p name sum stamp
  stamp="$(git rev-parse --absolute-git-dir)/coral-applied"
  touch "${stamp}"
  for p in "${ROOT}"/patches/*.patch; do
    [[ -e "${p}" ]] || continue
    name="$(basename "${p}")"
    sum="$(sha256sum "${p}" | cut -d' ' -f1)"
    if grep -qx "${name} ${sum}" "${stamp}"; then
      echo "  already applied: ${name}"
    elif grep -q "^${name} " "${stamp}"; then
      die "${name} changed since it was applied; delete work/ and rerun ./coral setup"
    elif git apply --reverse --check "${p}" 2>/dev/null; then
      echo "  already applied: ${name}"
      echo "${name} ${sum}" >> "${stamp}"
    else
      git apply --check "${p}" || die "patch does not apply: ${name}"
      git apply "${p}"
      echo "${name} ${sum}" >> "${stamp}"
      echo "  applied:         ${name}"
    fi
  done
  info "upstream ready at ${WORK} (${CORALNPU_COMMIT:0:8})"
}

# ---------------------------------------------------------------------------
bazel_files() {  # print output files of a target
  "$(bazel_cmd)" cquery --output=files "$1" 2>/dev/null
}

cmd_build() {
  need_vivado
  # The FuseSoC rule runs Vivado with a fake HOME, so ~/.Xilinx/Xilinx.lic is
  # not found there; upstream .bazelrc forwards XILINXD_LICENSE_FILE instead.
  if [[ -z "${XILINXD_LICENSE_FILE:-}" && -f "${HOME}/.Xilinx/Xilinx.lic" ]]; then
    export XILINXD_LICENSE_FILE="${HOME}/.Xilinx/Xilinx.lic"
  fi
  [[ -n "${XILINXD_LICENSE_FILE:-}" ]] ||
    die "no Vivado license: ./tools/setup-host.sh license <file> (or set XILINXD_LICENSE_FILE)"
  info "license: ${XILINXD_LICENSE_FILE}"
  # Vivado synthesis of the RVV subsystem was OOM-killed with 20 GB RAM + 2 GB swap.
  local mem_gb
  mem_gb=$(awk '/^(MemTotal|SwapTotal):/ {s+=$2} END {print int(s/1048576)}' /proc/meminfo)
  if (( mem_gb < 40 )); then
    echo "WARN: RAM+swap is ${mem_gb} GB; Vivado synthesis needs ~40 GB. Add swap:" >&2
    echo "      sudo fallocate -l 32G /swapfile-build && sudo chmod 600 /swapfile-build && sudo mkswap /swapfile-build && sudo swapon /swapfile-build" >&2
  fi
  ( cmd_setup )   # idempotent; picks up patches added since the last build
  if systemctl is-active --quiet systemd-oomd 2>/dev/null; then
    echo "WARN: systemd-oomd is running and kills long Vivado runs under swap; run ./tools/setup-host.sh (or: sudo systemctl mask --now systemd-oomd)" >&2
  fi
  local bz bit_target
  bz="$(bazel_cmd)"
  bit_target="//fpga:build_chip_vcu118_bitstream_${CONFIG}"
  cd "${WORK}"
  info "building ${bit_target} (Vivado synthesis + P&R: expect an hour or more)"
  "${bz}" build "${bit_target}"

  mkdir -p "${OUT}"
  local dir bit elf
  dir="$(bazel_files "${bit_target}" | head -n1)"
  # FuseSoC names the bitstream after the core (com.google.coralnpu_fpga_chip_vcu118_0.1.bit)
  bit="$(find "${WORK}/${dir}" -name '*.bit' | head -n1)"
  [[ -n "${bit}" ]] || die "no .bit under ${dir}"
  cp -f "${bit}" "${OUT}/chip_vcu118_${CONFIG}.bit"
  mkdir -p "${OUT}/reports_${CONFIG}"
  find "${WORK}/${dir}" \( -name '*utilization*.rpt' -o -name '*timing*.rpt' \) \
    -exec cp -f {} "${OUT}/reports_${CONFIG}/" \; 2>/dev/null || true

  cmd_sw
}

# Finish an interrupted bitstream build from the newest Vivado checkpoint that
# Bazel left in its sandbox (e.g. the VM was shut down during route_design).
# Run it before any other bazel/coral build: Bazel clears old sandboxes.
cmd_resume() {
  need_vivado
  if [[ -z "${XILINXD_LICENSE_FILE:-}" && -f "${HOME}/.Xilinx/Xilinx.lic" ]]; then
    export XILINXD_LICENSE_FILE="${HOME}/.Xilinx/Xilinx.lic"
  fi
  local impl ckpt dcp step d
  impl="$(find "${HOME}/.cache/bazel" -type d -path "*build.build_chip_vcu118_bitstream_${CONFIG}/*" \
            -name impl_1 -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n1 | cut -d' ' -f2-)"
  ckpt="${OUT}/ckpt_${CONFIG}"
  mkdir -p "${ckpt}"
  dcp=""
  for step in routed physopt placed opt; do
    for d in "${ckpt}" "${impl}"; do
      [[ -n "${d}" && -f "${d}/chip_vcu118_${step}.dcp" ]] && { dcp="${d}/chip_vcu118_${step}.dcp"; break 2; }
    done
  done
  [[ -n "${dcp}" ]] || die "no checkpoint for ${CONFIG} (looked in ${ckpt} and the Bazel sandbox)"
  [[ "$(dirname "${dcp}")" == "${ckpt}" ]] || cp -f "${dcp}" "${ckpt}/"
  dcp="${ckpt}/$(basename "${dcp}")"
  info "resuming ${CONFIG} from ${step}: ${dcp}"
  {
    echo "open_checkpoint {${dcp}}"
    case "${step}" in
      opt)      echo "place_design"; echo "phys_opt_design"
                echo "write_checkpoint -force {${ckpt}/chip_vcu118_physopt.dcp}" ;&
      placed|physopt)
                echo "route_design"
                echo "write_checkpoint -force {${ckpt}/chip_vcu118_routed.dcp}" ;;
    esac
    echo "report_route_status -file {${ckpt}/route_status.rpt}"
    echo "report_timing_summary -max_paths 20 -file {${ckpt}/timing_routed.rpt}"
    echo "report_utilization -file {${ckpt}/utilization_routed.rpt}"
    echo "write_bitstream -force {${OUT}/chip_vcu118_${CONFIG}.bit}"
  } > "${ckpt}/resume.tcl"
  ( cd "${ckpt}" && vivado -mode batch -nojournal -log resume.log -source resume.tcl ) ||
    die "Vivado failed; see ${ckpt}/resume.log"
  mkdir -p "${OUT}/reports_${CONFIG}"
  cp -f "${ckpt}"/*.rpt "${OUT}/reports_${CONFIG}/"
  grep -m1 -A3 "WNS(ns)" "${ckpt}/timing_routed.rpt" || true
  info "bitstream: ${OUT}/chip_vcu118_${CONFIG}.bit  (next: ./coral sw, then ./coral up)"
}

# hello.elf, rvv_test.elf + OpenOCD config only (no Vivado run). Uses its own
# Bazel output base, so it works while a bitstream build holds the main one.
SW_OUTPUT_BASE="${HOME}/.cache/coral-sw-bazel"
SW_TARGETS=(vcu118_hello vcu118_rvv_test vcu118_matmul_bench vcu118_vme_test)
SW_TARGETS+=("${SW_TARGETS[@]/%/_highmem}")   # linked for ITCM/DTCM 1 MB
# ELF suffix that matches the bitstream: *_highmem configs need *_highmem ELFs
sw_sfx() { [[ "${CONFIG}" == *highmem ]] && echo _highmem || true; }
cmd_sw() {
  need_vivado   # gen_openocd_cfg.sh reads the BSDL from the Vivado install
  ( cmd_setup )
  local bz t f
  bz="$(bazel_cmd)"
  cd "${WORK}"
  # --symlink_prefix=/ : do not repoint bazel-out/ while a bitstream build
  # in the main output base may still be using it.
  "${bz}" --output_base="${SW_OUTPUT_BASE}" build --symlink_prefix=/ "${SW_TARGETS[@]/#/\/\/fpga:}"
  local execroot
  execroot="$("${bz}" --output_base="${SW_OUTPUT_BASE}" info execution_root 2>/dev/null)"
  mkdir -p "${OUT}"
  for t in "${SW_TARGETS[@]}"; do
    f="$("${bz}" --output_base="${SW_OUTPUT_BASE}" cquery --output=files "//fpga:${t}" 2>/dev/null | grep '\.elf$' | head -n1)"
    [[ -n "${f}" ]] || die "no ELF for //fpga:${t}"
    cp -f "${execroot}/${f}" "${OUT}/${t}.elf"
  done
  "${WORK}/fpga/vcu118/gen_openocd_cfg.sh" > "${OUT}/openocd_vcu118.cfg"
  info "outputs:"; ls -la "${OUT}"
}

# Load an ELF over JTAG into the running chip and show what it prints.
cmd_run() {
  local elf="${1:-}" dev log
  [[ -f "${elf}" ]] || die "usage: ./coral run <program.elf>   (e.g. out/vcu118_rvv_test.elf)"
  dev="$(find_uart)"
  [[ -n "${dev}" ]] || die "no USB-UART found"
  uart_setup "${dev}"
  log="$(mktemp)"
  cat "${dev}" > "${log}" &
  UART_CAT_PID=$!
  trap 'kill "${UART_CAT_PID:-}" 2>/dev/null || true' EXIT
  cmd_load "${elf}" > "${log}.openocd" 2>&1 || { cat "${log}.openocd"; die "OpenOCD failed"; }
  for _ in $(seq 1 100); do
    grep -q "DONE" "${log}" && break
    sleep 0.2
  done
  info "console output (${dev}):"
  sed 's/\r//' "${log}"
  grep -q "DONE" "${log}" || die "program did not print DONE within 20 s"
}

# ---------------------------------------------------------------------------
cmd_program() {
  need_vivado
  local bit="${1:-${OUT}/chip_vcu118_${CONFIG}.bit}"
  [[ -f "${bit}" ]] || die "bitstream not found: ${bit} (run ./coral build)"
  info "programming ${bit} via hw_server ${HW_SERVER}"
  (cd "${OUT}" && vivado -mode batch -nojournal -nolog -notrace \
      -source "${ROOT}/vivado/program.tcl" -tclargs "${bit}" "${HW_SERVER}")
  # A local hw_server keeps the USB-JTAG open; OpenOCD needs it free.
  # (only our own: on a shared server other users may run hw_server too)
  if [[ "${HW_SERVER}" == localhost:* ]]; then pkill -u "$(id -u)" -x hw_server 2>/dev/null || true; fi
}

# ---------------------------------------------------------------------------
openocd_cfg() {
  local cfg="${OUT}/openocd_vcu118.cfg"
  if [[ ! -f "${cfg}" ]]; then
    need_vivado   # the generator reads the BSDL shipped with Vivado
    mkdir -p "${OUT}"
    "${WORK}/fpga/vcu118/gen_openocd_cfg.sh" > "${cfg}"
  fi
  echo "${cfg}"
}

cmd_load() {
  local elf="${1:-}"
  [[ -f "${elf}" ]] || die "usage: ./coral load <program.elf>"
  if pgrep -x hw_server >/dev/null; then
    pgrep -u "$(id -u)" -x hw_server >/dev/null &&
      die "your hw_server holds the JTAG cable. Close Vivado Hardware Manager or: pkill -u \$USER -x hw_server"
    die "another user's hw_server ($(pgrep -a -x hw_server | head -n1)) holds the JTAG cable; ask them to close it"
  fi
  local cfg entry
  cfg="$(openocd_cfg)"
  entry="$(readelf -h "${elf}" | awk '/Entry point address/ {print $4}')"
  info "loading ${elf} (entry ${entry})"
  # "reset halt" (ndmreset + haltreq) first: a program that returned from
  # main ends in mpause, which sets a sticky halted flag that only a core
  # reset clears; a plain resume then does nothing (seen 2026-10-19).
  if ! openocd -f "${cfg}" \
      -c "reset halt" \
      -c "load_image ${elf}" \
      -c "verify_image ${elf}" \
      -c "resume ${entry}" \
      -c "shutdown"; then
    echo "WARN: load with reset failed; retrying without reset" >&2
    openocd -f "${cfg}" \
      -c "load_image ${elf}" \
      -c "verify_image ${elf}" \
      -c "resume ${entry}" \
      -c "shutdown"
  fi
}

# ---------------------------------------------------------------------------
uart_setup() {
  stty -F "$1" "${UART_BAUD}" cs8 -cstopb -parenb raw -echo
}

cmd_console() {
  local dev; dev="$(find_uart)"
  [[ -n "${dev}" ]] || die "no USB-UART found (cable on J4?)"
  info "console on ${dev} @ ${UART_BAUD} (Ctrl-A Ctrl-X to quit picocom, Ctrl-C otherwise)"
  if command -v picocom >/dev/null; then exec picocom -b "${UART_BAUD}" "${dev}"; fi
  uart_setup "${dev}"; exec cat "${dev}"
}

# ---------------------------------------------------------------------------
cmd_up() {
  local dev log=""
  dev="$(find_uart)"
  if [[ -n "${dev}" ]]; then
    uart_setup "${dev}"
    log="$(mktemp)"
    cat "${dev}" > "${log}" &
    UART_CAT_PID=$!   # global: the EXIT trap runs after this function returns
    trap 'kill "${UART_CAT_PID:-}" 2>/dev/null || true' EXIT
  else
    echo "WARN: no USB-UART found; skipping the banner check"
  fi

  cmd_program "$@"

  if [[ -n "${log}" ]]; then
    info "waiting for the boot ROM banner"
    for _ in $(seq 1 50); do
      grep -q "ROM alive" "${log}" && break
      sleep 0.2
    done
    if grep -q "ROM alive" "${log}"; then
      sed 's/\r//' "${log}"
    else
      cat "${log}"
      local other
      other="$(ls /dev/ttyUSB* 2>/dev/null | grep -vx "${dev}" | head -n1)"
      die "no banner on ${dev}. Check LEDs (0 on = clock locked, 1 blinking, 6:4 walking = ROM running, 7 = DDR4 calibrated); other CP2105 port: UART_DEV=${other:-/dev/ttyUSB0} ./coral up"
    fi
  fi

  cmd_load "${OUT}/vcu118_hello$(sw_sfx).elf"

  if [[ -n "${log}" ]]; then
    sleep 1
    info "console output:"
    sed 's/\r//' "${log}"
    if grep -q "DONE" "${log}"; then
      info "CoralNPU is up."
    else
      die "hello.elf did not print DONE"
    fi
  fi
}

# ---------------------------------------------------------------------------
# shellcheck disable=SC2029  # remote paths are meant to expand here
cmd_deploy() {
  local then="${1:-}"
  local bit="${OUT}/chip_vcu118_${CONFIG}.bit" elf="${OUT}/vcu118_hello$(sw_sfx).elf"
  [[ -f "${bit}" && -f "${elf}" ]] || die "nothing to deploy: run ./coral build first (${bit})"
  local ssh_opts=(-p "${BOARD_SSH_PORT}" -o ServerAliveInterval=30)
  local remote_out="${BOARD_REPO}/out"
  info "deploying out/ to ${BOARD_SSH}:${remote_out} (port ${BOARD_SSH_PORT})"
  # One SSH connection for all steps, so the password is asked once.
  local ctl; ctl="$(mktemp -u "${TMPDIR:-/tmp}/coral-ssh-XXXXXX")"
  ssh "${ssh_opts[@]}" -o ControlMaster=yes -o ControlPath="${ctl}" -o ControlPersist=120 -fN "${BOARD_SSH}"
  ssh_opts+=(-o ControlPath="${ctl}")
  ssh "${ssh_opts[@]}" "${BOARD_SSH}" "test -d ${BOARD_REPO} || git clone -q https://github.com/SOTA-PNU/Coralnpu-vcu118.git ${BOARD_REPO}; mkdir -p ${remote_out}"
  local files=("${bit}" "${elf}")
  local f
  for f in "${OUT}"/*.rpt; do [[ -e "${f}" ]] && files+=("${f}"); done
  scp -P "${BOARD_SSH_PORT}" -o ControlPath="${ctl}" "${files[@]}" "${BOARD_SSH}:${remote_out}/"
  if [[ "${then}" == up ]]; then
    info "running coral up on the board host"
    ssh -t "${ssh_opts[@]}" "${BOARD_SSH}" \
      "cd ${BOARD_REPO} && git pull -q --ff-only && source ${BOARD_VIVADO_SETTINGS} && CONFIG=${CONFIG} ./coral up"
  else
    info "done. On the board host: cd ${BOARD_REPO} && ./coral up"
  fi
  ssh -o ControlPath="${ctl}" -O exit "${BOARD_SSH}" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Run a program that lives in DDR (IREE model ELFs: entry 0x8000_0000) and
# print the results it leaves in DTCM. Needs the vector_highmem bitstream with
# DDR4 (patch 0009) already programmed. See tools/ddr_run.py.
cmd_model() {
  local elf="${1:-}"; shift || true
  [[ -f "${elf}" ]] || die "usage: ./coral model <model.elf> [ddr_run.py options]"
  if pgrep -x hw_server >/dev/null; then
    die "hw_server holds the JTAG cable. Close Vivado Hardware Manager or: pkill -u \$USER -x hw_server"
  fi
  python3 "${ROOT}/tools/ddr_run.py" --cfg "$(openocd_cfg)" "${elf}" "$@"
}

# ---------------------------------------------------------------------------
# A few minutes, no synthesis: generate the DDR4 C1 controller the way the
# build will (same script, same fake HOME as FuseSoC) and print its config and
# port list. Run this before a multi-hour build that adds or changes DDR4.
cmd_ddr4_probe() {
  need_vivado
  local work="${OUT}/ddr4_probe" report="${OUT}/ddr4_probe.txt" fakehome
  mkdir -p "${OUT}"
  # The fake HOME hides ~/.Xilinx/Xilinx.lic, exactly as in cmd_build.
  if [[ -z "${XILINXD_LICENSE_FILE:-}" && -f "${HOME}/.Xilinx/Xilinx.lic" ]]; then
    export XILINXD_LICENSE_FILE="${HOME}/.Xilinx/Xilinx.lic"
  fi
  fakehome="$(mktemp -d)"
  info "generating the DDR4 C1 IP in ${work} (HOME=${fakehome}, like the FuseSoC build)"
  (cd "${OUT}" && HOME="${fakehome}" vivado -mode batch -nojournal -nolog -notrace \
      -source "${ROOT}/vivado/ddr4_probe.tcl" -tclargs "${work}" "$@") 2>&1 |
    grep -E "^(PROBE|DDR4C1):|ERROR|CRITICAL" | tee "${report}"
  rm -rf "${fakehome}"
  grep -q "^PROBE: done" "${report}" || die "probe did not finish; see ${report}"
  info "saved ${report}"
}

# ---------------------------------------------------------------------------
sub="${1:-}"; shift || true
case "${sub}" in
  ddr4-probe) cmd_ddr4_probe "$@" ;;
  doctor|setup|build|resume|sw|run|program|load|console|up|deploy|model) "cmd_${sub}" "$@" ;;
  *) sed -n '2,/^# Environment/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
