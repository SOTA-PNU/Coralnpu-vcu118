From 78b5bba70fd94d926df2de2ad084ecba112a2fa4 Mon Sep 17 00:00:00 2001
From: donghun <ehdgns1083@pusan.ac.kr>
Date: Thu, 29 Oct 2026 18:16:15 +0900
Subject: [PATCH] fpga/vcu118: DDR4 C1 at 0x80000000 (Vivado DDR4 controller
 from the board files)

The public tree only has ddr4_stub; Nexus uses an internal MIG core. Here
the controller is generated from the IP catalog with the VCU118 board files
(vcu118_ddr4_c1_ip.tcl, sourced by the setup hook), so the board flow places
the 118 memory/clock pins. Board preset: 64-bit DQ, DDR4-2400, AXI 512 bit,
ui_clk 300 MHz (width and speed are locked by the preset).

The SoC's 256-bit DDR AXI goes through an axi_dwidth_converter with
asynchronous clock conversion, so the SoC's DDR side stays on the 50 MHz main
clock and only Xilinx IP runs at 300 MHz. Address bit 31 is dropped
(0x8000_0000 -> controller 0). The DDR control AXI port (ECC registers on
Nexus) gets an OKAY responder. init_calib_complete drives GPIO input bit 0
(xpm_cdc_single) and LED 7; LEDs 6:4 show GPIO 2:0. The controller reset is
CPU_RESET or not-yet-EOS (STARTUPE3), as on Nexus.

Port widths were taken from the generated instantiation template; the build
stops in the setup hook if the IP comes out differently.
---
 fpga/BUILD                  |   4 +-
 fpga/chip_vcu118.core       |   3 +-
 fpga/rtl/chip_vcu118.sv     | 503 +++++++++++++++++++++++++++++++-----
 fpga/vcu118_ddr4_c1_ip.tcl  | 145 +++++++++++
 fpga/vcu118_setup_hooks.tcl |   4 +
 5 files changed, 586 insertions(+), 73 deletions(-)
 create mode 100644 fpga/vcu118_ddr4_c1_ip.tcl

diff --git a/fpga/BUILD b/fpga/BUILD
index 58a7e39..aad722d 100644
--- a/fpga/BUILD
+++ b/fpga/BUILD
@@ -919,7 +919,8 @@ collect_coralnpu_elfs()
 # Debug transport goes over the FPGA's own JTAG (BSCANE2), so the board needs
 # no extra cable. The SoC boots a small ROM (sw/vcu118/rom_park.c) that prints
 # a banner on the USB-UART and parks; programs are then loaded with OpenOCD.
-# DDR4 is not connected in this build (see rtl/chip_vcu118.sv).
+# DDR4 C1 (2 GB) at 0x8000_0000 through a Vivado DDR4 controller generated
+# from the VCU118 board files (vcu118_ddr4_c1_ip.tcl, see rtl/chip_vcu118.sv).
 #
 #   bazel build //fpga:build_chip_vcu118_synth_only_vector_normal   # LUT count
 #   bazel build //fpga:build_chip_vcu118_bitstream_vector_normal    # .bit
@@ -1004,6 +1005,7 @@ coralnpu_v2_binary(
 
 VCU118_VIVADO_HOOKS = [
     "vcu118_setup_hooks.tcl",
+    "vcu118_ddr4_c1_ip.tcl",
     "vcu118_pre_opt_hooks.tcl",
     "check_pin_assignments.tcl",
     "vivado_post_place_hooks.tcl",
diff --git a/fpga/chip_vcu118.core b/fpga/chip_vcu118.core
index 8c6f5a8..82edc71 100644
--- a/fpga/chip_vcu118.core
+++ b/fpga/chip_vcu118.core
@@ -13,7 +13,7 @@ CAPI=2:
 # See the License for the specific language governing permissions and
 # limitations under the License.
 name: "com.google.coralnpu:fpga:chip_vcu118:0.1"
-description: "VCU118-specific top-level for CoralNPU (BSCANE2 debug, no DDR)."
+description: "VCU118-specific top-level for CoralNPU (BSCANE2 debug, DDR4 C1)."
 
 filesets:
   files_rtl:
@@ -35,6 +35,7 @@ filesets:
   files_tcl:
     files:
       - vcu118_setup_hooks.tcl: { file_type: tclSource }
+      - vcu118_ddr4_c1_ip.tcl: { file_type: user, copyto: vcu118_ddr4_c1_ip.tcl }
       - check_pin_assignments.tcl: { file_type: user, copyto: check_pin_assignments.tcl }
       - vcu118_pre_opt_hooks.tcl: { file_type: user, copyto: vcu118_pre_opt_hooks.tcl }
       - vivado_post_place_hooks.tcl: { file_type: user, copyto: vivado_post_place_hooks.tcl }
diff --git a/fpga/rtl/chip_vcu118.sv b/fpga/rtl/chip_vcu118.sv
index 1914fc2..968c9c8 100644
--- a/fpga/rtl/chip_vcu118.sv
+++ b/fpga/rtl/chip_vcu118.sv
@@ -22,12 +22,21 @@
 //            talks to the same USB-JTAG used to load the bitstream.
 //   * UART:  the software console is UART1 (0x4001_0000, see fpga/sw/uart.c),
 //            so UART1 goes to the on-board CP2105 USB-UART. UART0 is unused.
-//   * DDR4:  not connected yet. The SoC's DDR AXI ports are tied off exactly
-//            like fpga/ip/ddr4_stub (never ready), so any access to
-//            0x8000_0000.. hangs the bus. Do not touch DDR on this build.
+//   * DDR4:  the on-board C1 component memory (2 GB, 64-bit, DDR4-2400) through
+//            a Vivado DDR4 controller "ddr4_c1" generated from the VCU118
+//            board files (vcu118_ddr4_c1_ip.tcl), at 0x8000_0000 like Nexus.
+//            Nexus clocks the SoC's DDR side with the controller's ui_clk;
+//            here that side stays on the 50 MHz main clock and an AXI
+//            width/clock converter "ddr4_c1_axi_up" (256 -> 512 bits,
+//            main clk -> 300 MHz ui_clk) sits in front of the controller,
+//            so only Xilinx IP runs at 300 MHz. The SoC's AXI-lite DDR
+//            control port (ECC registers on Nexus) gets an OKAY responder.
+//            init_calib_complete -> GPIO input bit 0 and LED 7: software
+//            must wait for it before touching DDR (an early access stalls
+//            the bus until calibration ends).
 //   * SPI device / SPI host / SPI flash / I2C / camera: not connected.
 //   * LEDs: [0] MMCM locked [1] heartbeat [2] io_halted [3] io_fault
-//           [7:4] SoC GPIO[3:0]
+//           [6:4] SoC GPIO[2:0] [7] DDR4 calibrated
 module chip_vcu118 #(
     parameter MemInitFile = "",
     parameter int ClockFrequencyMhz = 50,
@@ -44,7 +53,25 @@ module chip_vcu118 #(
     input  logic       cpu_reset,     // active high push button
     output logic       uart_txd,      // FPGA -> CP2105 (USB_UART_TX)
     input  logic       uart_rxd,      // CP2105 -> FPGA (USB_UART_RX)
-    output logic [7:0] led
+    output logic [7:0] led,
+    // DDR4 C1. Port names match the controller's so the board flow
+    // (ddr4_c1_board.xdc) places them; do not rename.
+    input  logic        c0_sys_clk_p,  // 250 MHz (default_250mhz_clk1)
+    input  logic        c0_sys_clk_n,
+    output logic        c0_ddr4_act_n,
+    output logic [16:0] c0_ddr4_adr,
+    output logic [1:0]  c0_ddr4_ba,
+    output logic [0:0]  c0_ddr4_bg,
+    output logic [0:0]  c0_ddr4_cke,
+    output logic [0:0]  c0_ddr4_odt,
+    output logic [0:0]  c0_ddr4_cs_n,
+    output logic [0:0]  c0_ddr4_ck_t,
+    output logic [0:0]  c0_ddr4_ck_c,
+    output logic        c0_ddr4_reset_n,
+    inout  wire  [7:0]  c0_ddr4_dm_dbi_n,
+    inout  wire  [63:0] c0_ddr4_dq,
+    inout  wire  [7:0]  c0_ddr4_dqs_t,
+    inout  wire  [7:0]  c0_ddr4_dqs_c
 );
 
   // ------------------------------------------------------------------
@@ -81,6 +108,7 @@ module chip_vcu118 #(
   // ------------------------------------------------------------------
   logic [7:0] gpio_out, gpio_en;
   logic io_halted, io_fault;
+  logic ddr_calib, ddr_calib_sync;
 
   // ~1.5 Hz at 50 MHz: proves the main clock is alive without any software.
   logic [24:0] heartbeat_q;
@@ -93,7 +121,8 @@ module chip_vcu118 #(
   assign led[1]   = heartbeat_q[24];
   assign led[2]   = io_halted;
   assign led[3]   = io_fault;
-  assign led[7:4] = gpio_out[3:0] & gpio_en[3:0];
+  assign led[6:4] = gpio_out[2:0] & gpio_en[2:0];
+  assign led[7]   = ddr_calib;
 
   // ------------------------------------------------------------------
   // RISC-V debug transport over BSCANE2
@@ -127,10 +156,255 @@ module chip_vcu118 #(
   );
 
   // ------------------------------------------------------------------
-  // DDR AXI tie-off (same behaviour as fpga/ip/ddr4_stub: never ready)
+  // DDR4: SoC (main clk, 256 bit) -> ddr4_c1_axi_up -> ddr4_c1 (ui_clk, 512 bit)
   // ------------------------------------------------------------------
-  logic ddr_ctrl_aw_valid, ddr_ctrl_w_valid, ddr_ctrl_ar_valid;
-  logic ddr_mem_aw_valid, ddr_mem_w_valid, ddr_mem_ar_valid;
+  // SoC side, main clock
+  logic [31:0]  m_awaddr, m_araddr;
+  logic [0:0]   m_awid, m_arid, m_bid, m_rid;
+  logic [7:0]   m_awlen, m_arlen;
+  logic [2:0]   m_awsize, m_arsize, m_awprot, m_arprot;
+  logic [1:0]   m_awburst, m_arburst, m_bresp, m_rresp;
+  logic         m_awlock, m_arlock;
+  logic [3:0]   m_awcache, m_arcache, m_awqos, m_arqos, m_awregion, m_arregion;
+  logic         m_awvalid, m_awready, m_wvalid, m_wready, m_wlast;
+  logic         m_bvalid, m_bready, m_arvalid, m_arready;
+  logic         m_rvalid, m_rready, m_rlast;
+  logic [255:0] m_wdata, m_rdata;
+  logic [31:0]  m_wstrb;
+  logic [3:0]   up_bid, up_rid;
+
+  // Controller side, ui_clk (300 MHz)
+  logic         ui_clk, ui_rst;
+  logic [30:0]  c_awaddr, c_araddr;
+  logic [7:0]   c_awlen, c_arlen;
+  logic [2:0]   c_awsize, c_arsize, c_awprot, c_arprot;
+  logic [1:0]   c_awburst, c_arburst, c_bresp, c_rresp;
+  logic [0:0]   c_awlock, c_arlock;
+  logic [3:0]   c_awcache, c_arcache, c_awqos, c_arqos;
+  logic         c_awvalid, c_awready, c_wvalid, c_wready, c_wlast;
+  logic         c_bvalid, c_bready, c_arvalid, c_arready;
+  logic         c_rvalid, c_rready, c_rlast;
+  logic [511:0] c_wdata, c_rdata;
+  logic [63:0]  c_wstrb;
+
+  // Controller reset: push button, and hold until configuration is done
+  // (STARTUPE3 EOS), as chip_nexus does.
+  logic eos;
+  STARTUPE3 i_startupe3 (
+      .EOS      (eos),
+      .CFGCLK   (),
+      .CFGMCLK  (),
+      .PREQ     (),
+      .DI       (),
+      .DO       (4'b0),
+      .DTS      (4'b1111),
+      .FCSBO    (1'b1),
+      .FCSBTS   (1'b1),
+      .GSR      (1'b0),
+      .GTS      (1'b0),
+      .KEYCLEARB(1'b1),
+      .PACK     (1'b0),
+      .USRCCLKO (1'b0),
+      .USRCCLKTS(1'b1),
+      .USRDONEO (1'b1),
+      .USRDONETS(1'b1)
+  );
+
+  ddr4_c1 i_ddr4 (
+      .sys_rst                (cpu_reset | ~eos),
+      .c0_sys_clk_p           (c0_sys_clk_p),
+      .c0_sys_clk_n           (c0_sys_clk_n),
+      .c0_init_calib_complete (ddr_calib),
+      .dbg_clk                (),
+      .dbg_bus                (),
+      .addn_ui_clkout1        (),
+      .c0_ddr4_act_n          (c0_ddr4_act_n),
+      .c0_ddr4_adr            (c0_ddr4_adr),
+      .c0_ddr4_ba             (c0_ddr4_ba),
+      .c0_ddr4_bg             (c0_ddr4_bg),
+      .c0_ddr4_cke            (c0_ddr4_cke),
+      .c0_ddr4_odt            (c0_ddr4_odt),
+      .c0_ddr4_cs_n           (c0_ddr4_cs_n),
+      .c0_ddr4_ck_t           (c0_ddr4_ck_t),
+      .c0_ddr4_ck_c           (c0_ddr4_ck_c),
+      .c0_ddr4_reset_n        (c0_ddr4_reset_n),
+      .c0_ddr4_dm_dbi_n       (c0_ddr4_dm_dbi_n),
+      .c0_ddr4_dq             (c0_ddr4_dq),
+      .c0_ddr4_dqs_c          (c0_ddr4_dqs_c),
+      .c0_ddr4_dqs_t          (c0_ddr4_dqs_t),
+      .c0_ddr4_ui_clk         (ui_clk),
+      .c0_ddr4_ui_clk_sync_rst(ui_rst),
+      .c0_ddr4_aresetn        (~ui_rst),
+      .c0_ddr4_s_axi_awid     (4'b0),
+      .c0_ddr4_s_axi_awaddr   (c_awaddr),
+      .c0_ddr4_s_axi_awlen    (c_awlen),
+      .c0_ddr4_s_axi_awsize   (c_awsize),
+      .c0_ddr4_s_axi_awburst  (c_awburst),
+      .c0_ddr4_s_axi_awlock   (c_awlock),
+      .c0_ddr4_s_axi_awcache  (c_awcache),
+      .c0_ddr4_s_axi_awprot   (c_awprot),
+      .c0_ddr4_s_axi_awqos    (c_awqos),
+      .c0_ddr4_s_axi_awvalid  (c_awvalid),
+      .c0_ddr4_s_axi_awready  (c_awready),
+      .c0_ddr4_s_axi_wdata    (c_wdata),
+      .c0_ddr4_s_axi_wstrb    (c_wstrb),
+      .c0_ddr4_s_axi_wlast    (c_wlast),
+      .c0_ddr4_s_axi_wvalid   (c_wvalid),
+      .c0_ddr4_s_axi_wready   (c_wready),
+      .c0_ddr4_s_axi_bready   (c_bready),
+      .c0_ddr4_s_axi_bid      (),
+      .c0_ddr4_s_axi_bresp    (c_bresp),
+      .c0_ddr4_s_axi_bvalid   (c_bvalid),
+      .c0_ddr4_s_axi_arid     (4'b0),
+      .c0_ddr4_s_axi_araddr   (c_araddr),
+      .c0_ddr4_s_axi_arlen    (c_arlen),
+      .c0_ddr4_s_axi_arsize   (c_arsize),
+      .c0_ddr4_s_axi_arburst  (c_arburst),
+      .c0_ddr4_s_axi_arlock   (c_arlock),
+      .c0_ddr4_s_axi_arcache  (c_arcache),
+      .c0_ddr4_s_axi_arprot   (c_arprot),
+      .c0_ddr4_s_axi_arqos    (c_arqos),
+      .c0_ddr4_s_axi_arvalid  (c_arvalid),
+      .c0_ddr4_s_axi_arready  (c_arready),
+      .c0_ddr4_s_axi_rready   (c_rready),
+      .c0_ddr4_s_axi_rlast    (c_rlast),
+      .c0_ddr4_s_axi_rvalid   (c_rvalid),
+      .c0_ddr4_s_axi_rresp    (c_rresp),
+      .c0_ddr4_s_axi_rid      (),
+      .c0_ddr4_s_axi_rdata    (c_rdata)
+  );
+
+  // 0x8000_0000.. -> controller address 0 (2 GB window, bit 31 dropped).
+  ddr4_c1_axi_up i_ddr_axi_up (
+      .s_axi_aclk    (clk),
+      .s_axi_aresetn (rst_n),
+      .s_axi_awid    ({3'b0, m_awid}),
+      .s_axi_awaddr  (m_awaddr[30:0]),
+      .s_axi_awlen   (m_awlen),
+      .s_axi_awsize  (m_awsize),
+      .s_axi_awburst (m_awburst),
+      .s_axi_awlock  (m_awlock),
+      .s_axi_awcache (m_awcache),
+      .s_axi_awprot  (m_awprot),
+      .s_axi_awregion(m_awregion),
+      .s_axi_awqos   (m_awqos),
+      .s_axi_awvalid (m_awvalid),
+      .s_axi_awready (m_awready),
+      .s_axi_wdata   (m_wdata),
+      .s_axi_wstrb   (m_wstrb),
+      .s_axi_wlast   (m_wlast),
+      .s_axi_wvalid  (m_wvalid),
+      .s_axi_wready  (m_wready),
+      .s_axi_bid     (up_bid),
+      .s_axi_bresp   (m_bresp),
+      .s_axi_bvalid  (m_bvalid),
+      .s_axi_bready  (m_bready),
+      .s_axi_arid    ({3'b0, m_arid}),
+      .s_axi_araddr  (m_araddr[30:0]),
+      .s_axi_arlen   (m_arlen),
+      .s_axi_arsize  (m_arsize),
+      .s_axi_arburst (m_arburst),
+      .s_axi_arlock  (m_arlock),
+      .s_axi_arcache (m_arcache),
+      .s_axi_arprot  (m_arprot),
+      .s_axi_arregion(m_arregion),
+      .s_axi_arqos   (m_arqos),
+      .s_axi_arvalid (m_arvalid),
+      .s_axi_arready (m_arready),
+      .s_axi_rid     (up_rid),
+      .s_axi_rdata   (m_rdata),
+      .s_axi_rresp   (m_rresp),
+      .s_axi_rlast   (m_rlast),
+      .s_axi_rvalid  (m_rvalid),
+      .s_axi_rready  (m_rready),
+      .m_axi_aclk    (ui_clk),
+      .m_axi_aresetn (~ui_rst),
+      .m_axi_awaddr  (c_awaddr),
+      .m_axi_awlen   (c_awlen),
+      .m_axi_awsize  (c_awsize),
+      .m_axi_awburst (c_awburst),
+      .m_axi_awlock  (c_awlock),
+      .m_axi_awcache (c_awcache),
+      .m_axi_awprot  (c_awprot),
+      .m_axi_awregion(),
+      .m_axi_awqos   (c_awqos),
+      .m_axi_awvalid (c_awvalid),
+      .m_axi_awready (c_awready),
+      .m_axi_wdata   (c_wdata),
+      .m_axi_wstrb   (c_wstrb),
+      .m_axi_wlast   (c_wlast),
+      .m_axi_wvalid  (c_wvalid),
+      .m_axi_wready  (c_wready),
+      .m_axi_bresp   (c_bresp),
+      .m_axi_bvalid  (c_bvalid),
+      .m_axi_bready  (c_bready),
+      .m_axi_araddr  (c_araddr),
+      .m_axi_arlen   (c_arlen),
+      .m_axi_arsize  (c_arsize),
+      .m_axi_arburst (c_arburst),
+      .m_axi_arlock  (c_arlock),
+      .m_axi_arcache (c_arcache),
+      .m_axi_arprot  (c_arprot),
+      .m_axi_arregion(),
+      .m_axi_arqos   (c_arqos),
+      .m_axi_arvalid (c_arvalid),
+      .m_axi_arready (c_arready),
+      .m_axi_rdata   (c_rdata),
+      .m_axi_rresp   (c_rresp),
+      .m_axi_rlast   (c_rlast),
+      .m_axi_rvalid  (c_rvalid),
+      .m_axi_rready  (c_rready)
+  );
+  assign m_bid = up_bid[0];
+  assign m_rid = up_rid[0];
+
+  // Calibration status into the main clock domain (GPIO input bit 0).
+  xpm_cdc_single #(
+      .DEST_SYNC_FF  (3),
+      .SRC_INPUT_REG (0)
+  ) i_calib_sync (
+      .src_clk (1'b0),
+      .src_in  (ddr_calib),
+      .dest_clk(clk),
+      .dest_out(ddr_calib_sync)
+  );
+
+  // AXI-lite DDR control port (ECC registers on Nexus): answer OKAY / 0.
+  logic        dc_awvalid, dc_awready, dc_wvalid, dc_wready, dc_wlast;
+  logic        dc_bvalid, dc_bready, dc_arvalid, dc_arready;
+  logic        dc_rvalid, dc_rready, dc_rlast;
+  logic [5:0]  dc_awid, dc_arid, dc_bid, dc_rid;
+  logic [7:0]  dc_arlen;
+  logic [1:0]  dc_bresp, dc_rresp;
+  logic [31:0] dc_rdata;
+
+  vcu118_axi_okay_slave #(
+      .IdWidth  (6),
+      .DataWidth(32)
+  ) i_ddr_ctrl_okay (
+      .clk_i     (clk),
+      .rst_ni    (rst_n),
+      .aw_valid_i(dc_awvalid),
+      .aw_ready_o(dc_awready),
+      .aw_id_i   (dc_awid),
+      .w_valid_i (dc_wvalid),
+      .w_ready_o (dc_wready),
+      .w_last_i  (dc_wlast),
+      .b_valid_o (dc_bvalid),
+      .b_ready_i (dc_bready),
+      .b_id_o    (dc_bid),
+      .b_resp_o  (dc_bresp),
+      .ar_valid_i(dc_arvalid),
+      .ar_ready_o(dc_arready),
+      .ar_id_i   (dc_arid),
+      .ar_len_i  (dc_arlen),
+      .r_valid_o (dc_rvalid),
+      .r_ready_i (dc_rready),
+      .r_id_o    (dc_rid),
+      .r_data_o  (dc_rdata),
+      .r_resp_o  (dc_rresp),
+      .r_last_o  (dc_rlast)
+  );
 
   // ------------------------------------------------------------------
   // SoC
@@ -170,7 +444,7 @@ module chip_vcu118 #(
       .spim_flash_rst_no(),
       .gpio_o           (gpio_out),
       .gpio_en_o        (gpio_en),
-      .gpio_i           (8'h00),
+      .gpio_i           ({7'h00, ddr_calib_sync}),
       // Camera / ISP: no sensor on this board
       .ISP_DVP_D0       (1'b0),
       .ISP_DVP_D1       (1'b0),
@@ -197,15 +471,15 @@ module chip_vcu118 #(
       .sda_en_o         (),
       .io_halted        (io_halted),
       .io_fault         (io_fault),
-      // DDR: clocked so the CDC logic is not left floating, but never ready
+      // DDR side on the main clock; ddr4_c1_axi_up crosses to ui_clk.
       .ddr_clk_i        (clk),
