From 251b7bfe6744ba5c09f0e75b25366da423bca6f4 Mon Sep 17 00:00:00 2001
From: Donghun Yu <ehdgns1083@pusan.ac.kr>
Date: Mon, 16 Nov 2026 16:44:58 +0900
Subject: [PATCH] fpga/vcu118: PCIe Gen3 x8 XDMA into DDR4 C1

Host DMA into the on-board DDR4 through the edge connector, so a model can
be loaded over PCIe instead of the 74 KB/s USB-UART.

- pcie_xdma: Gen3 x8, AXI-MM DMA, 256-bit at 250 MHz, 1 H2C + 1 C2H.
  Lanes and PERST# from the board interfaces (pci_express_x8, pcie_perstn).
- pcie_axi_cdc: async 250 MHz -> 50 MHz main clock.
- ddr_axi_xbar: 2:1 crossbar on the main clock (S00 SoC, S01 PCIe) in
  front of ddr4_c1_axi_up, whose ID widens 4 -> 5. The 300 MHz side is
  unchanged. Card address 0 = DDR offset 0 = SoC 0x8000_0000.
- vcu118_pcie_ip.tcl writes the reference clock (IBUFDS_GTE4) and PERST#
  PACKAGE_PINs from the board files into vcu118_pcie_pins.xdc.
- GPIO input bit 4 = PCIe link up.
- check_pin_assignments: pci_exp_* are placed by the XDMA GT LOCs.
---
 fpga/BUILD                     |   1 +
 fpga/check_pin_assignments.tcl |   7 +
 fpga/chip_vcu118.core          |   3 +-
 fpga/rtl/chip_vcu118.sv        | 410 +++++++++++++++++++++++++++++----
 fpga/vcu118_pcie_ip.tcl        | 192 +++++++++++++++
 fpga/vcu118_setup_hooks.tcl    |   6 +
 6 files changed, 574 insertions(+), 45 deletions(-)
 create mode 100644 fpga/vcu118_pcie_ip.tcl

diff --git a/fpga/BUILD b/fpga/BUILD
index c521cf7..9e9b838 100644
--- a/fpga/BUILD
+++ b/fpga/BUILD
@@ -1006,6 +1006,7 @@ coralnpu_v2_binary(
 VCU118_VIVADO_HOOKS = [
     "vcu118_setup_hooks.tcl",
     "vcu118_ddr4_c1_ip.tcl",
+    "vcu118_pcie_ip.tcl",
     "vcu118_ddr4_fw.tcl",
     "vcu118_bitstream_pre_hooks.tcl",
     "vcu118_bitstream_post_hooks.tcl",
diff --git a/fpga/check_pin_assignments.tcl b/fpga/check_pin_assignments.tcl
index 04e7a53..416d50c 100644
--- a/fpga/check_pin_assignments.tcl
+++ b/fpga/check_pin_assignments.tcl
@@ -29,6 +29,13 @@ if {[llength [get_files -quiet {*pins_ddr_stub.xdc}]] > 0} {
     lappend ignore_patterns "*c0_sys_clk*"
 }
 
+# PCIe lanes (patch 0014): the XDMA IP places them through its GT channel
+# LOCs (PCIE_BOARD_INTERFACE), so the ports carry no PACKAGE_PIN before placement.
+if {[llength [get_cells -quiet -hier -filter {REF_NAME == pcie_xdma}]] > 0} {
+    puts "INFO: PCIe XDMA detected. Ignoring pci_exp_* (placed by the IP GT LOCs)."
+    lappend ignore_patterns "pci_exp_*"
+}
+
 set missing_pins {}
 
 foreach port $all_ports {
diff --git a/fpga/chip_vcu118.core b/fpga/chip_vcu118.core
index 874e4ea..0b92915 100644
--- a/fpga/chip_vcu118.core
+++ b/fpga/chip_vcu118.core
@@ -13,7 +13,7 @@ CAPI=2:
 # See the License for the specific language governing permissions and
 # limitations under the License.
 name: "com.google.coralnpu:fpga:chip_vcu118:0.1"
-description: "VCU118-specific top-level for CoralNPU (BSCANE2 debug, DDR4 C1)."
+description: "VCU118-specific top-level for CoralNPU (BSCANE2 debug, DDR4 C1, PCIe XDMA)."
 
 filesets:
   files_rtl:
@@ -36,6 +36,7 @@ filesets:
     files:
       - vcu118_setup_hooks.tcl: { file_type: tclSource }
       - vcu118_ddr4_c1_ip.tcl: { file_type: user, copyto: vcu118_ddr4_c1_ip.tcl }
+      - vcu118_pcie_ip.tcl: { file_type: user, copyto: vcu118_pcie_ip.tcl }
       - vcu118_ddr4_fw.tcl: { file_type: user, copyto: vcu118_ddr4_fw.tcl }
       - vcu118_bitstream_pre_hooks.tcl: { file_type: user, copyto: vcu118_bitstream_pre_hooks.tcl }
       - vcu118_bitstream_post_hooks.tcl: { file_type: user, copyto: vcu118_bitstream_post_hooks.tcl }
diff --git a/fpga/rtl/chip_vcu118.sv b/fpga/rtl/chip_vcu118.sv
index c1e3a3a..189f9cf 100644
--- a/fpga/rtl/chip_vcu118.sv
+++ b/fpga/rtl/chip_vcu118.sv
@@ -43,6 +43,12 @@
 //           [7] on when calibration is complete
 //   * GPIO inputs: [0] calibration complete [1] controller out of reset
 //                  [2] STARTUPE3 EOS   [3] DDR4 power-on reset still held
+//                  [4] PCIe link up
+//   * PCIe:  Gen3 x8 XDMA on the edge connector (patch 0014). The host DMAs
+//            into DDR4 C1: card address 0 = SoC 0x8000_0000. An AXI crossbar
+//            on the 50 MHz main clock shares the DDR path between the SoC
+//            (S00) and the XDMA (S01, through an async clock converter), in
+//            front of ddr4_c1_axi_up, so the 300 MHz side is unchanged.
 module chip_vcu118 #(
     parameter MemInitFile = "",
     parameter int ClockFrequencyMhz = 50,
@@ -77,7 +83,17 @@ module chip_vcu118 #(
     inout  wire  [7:0]  c0_ddr4_dm_dbi_n,
     inout  wire  [63:0] c0_ddr4_dq,
     inout  wire  [7:0]  c0_ddr4_dqs_t,
-    inout  wire  [7:0]  c0_ddr4_dqs_c
+    inout  wire  [7:0]  c0_ddr4_dqs_c,
+    // PCIe edge connector, Gen3 x8 (patch 0014). Lanes and PERST# are placed
+    // by the XDMA board interfaces, the reference clock by the XDC that
+    // vcu118_pcie_ip.tcl writes from the board files.
+    input  logic        pcie_refclk_p,  // 100 MHz from the host slot
+    input  logic        pcie_refclk_n,
+    input  logic        pcie_perst_n,
+    output logic [7:0]  pci_exp_txp,
+    output logic [7:0]  pci_exp_txn,
+    input  logic [7:0]  pci_exp_rxp,
+    input  logic [7:0]  pci_exp_rxn
 );
 
   // ------------------------------------------------------------------
@@ -202,7 +218,6 @@ module chip_vcu118 #(
   logic         m_rvalid, m_rready, m_rlast;
   logic [255:0] m_wdata, m_rdata;
   logic [31:0]  m_wstrb;
-  logic [3:0]   up_bid, up_rid;
 
   // Controller side, ui_clk (300 MHz)
   logic [30:0]  c_awaddr, c_araddr;
@@ -316,49 +331,356 @@ module chip_vcu118 #(
       .c0_ddr4_s_axi_rdata    (c_rdata)
   );
 
+  // ------------------------------------------------------------------
+  // PCIe (patch 0014): host -> XDMA (250 MHz) -> pcie_axi_cdc (50 MHz)
+  // -> ddr_axi_xbar S01. The SoC is S00. Card address 0 = DDR offset 0
+  // = SoC 0x8000_0000.
+  // ------------------------------------------------------------------
+  logic pcie_sys_clk, pcie_sys_clk_gt;
+  logic pcie_aclk, pcie_aresetn, pcie_lnk_up, pcie_lnk_up_sync;
+
+  IBUFDS_GTE4 #(
+      .REFCLK_HROW_CK_SEL(2'b00)  // ODIV2 = O / 1, as the XDMA example design
+  ) i_pcie_refclk_buf (
+      .I    (pcie_refclk_p),
+      .IB   (pcie_refclk_n),
+      .CEB  (1'b0),
+      .O    (pcie_sys_clk_gt),
+      .ODIV2(pcie_sys_clk)
+  );
+
+  // XDMA master, axi_aclk domain
+  logic [3:0]   p_awid, p_arid, p_bid, p_rid;
+  logic [63:0]  p_awaddr, p_araddr;
+  logic [7:0]   p_awlen, p_arlen;
+  logic [2:0]   p_awsize, p_arsize, p_awprot, p_arprot;
+  logic [1:0]   p_awburst, p_arburst, p_bresp, p_rresp;
+  logic         p_awlock, p_arlock;
+  logic [3:0]   p_awcache, p_arcache;
+  logic         p_awvalid, p_awready, p_wvalid, p_wready, p_wlast;
+  logic         p_bvalid, p_bready, p_arvalid, p_arready;
+  logic         p_rvalid, p_rready, p_rlast;
+  logic [255:0] p_wdata, p_rdata;
+  logic [31:0]  p_wstrb;
+
+  pcie_xdma i_pcie_xdma (
+      .sys_clk         (pcie_sys_clk),
+      .sys_clk_gt      (pcie_sys_clk_gt),
+      .sys_rst_n       (pcie_perst_n),
+      .user_lnk_up     (pcie_lnk_up),
+      .pci_exp_txp     (pci_exp_txp),
+      .pci_exp_txn     (pci_exp_txn),
+      .pci_exp_rxp     (pci_exp_rxp),
+      .pci_exp_rxn     (pci_exp_rxn),
+      .axi_aclk        (pcie_aclk),
+      .axi_aresetn     (pcie_aresetn),
+      .usr_irq_req     (1'b0),
+      .usr_irq_ack     (),
+      .msi_enable      (),
+      .msi_vector_width(),
+      .m_axi_awready   (p_awready),
+      .m_axi_wready    (p_wready),
+      .m_axi_bid       (p_bid),
+      .m_axi_bresp     (p_bresp),
+      .m_axi_bvalid    (p_bvalid),
+      .m_axi_arready   (p_arready),
+      .m_axi_rid       (p_rid),
+      .m_axi_rdata     (p_rdata),
+      .m_axi_rresp     (p_rresp),
+      .m_axi_rlast     (p_rlast),
+      .m_axi_rvalid    (p_rvalid),
+      .m_axi_awid      (p_awid),
+      .m_axi_awaddr    (p_awaddr),
+      .m_axi_awlen     (p_awlen),
+      .m_axi_awsize    (p_awsize),
+      .m_axi_awburst   (p_awburst),
+      .m_axi_awprot    (p_awprot),
+      .m_axi_awvalid   (p_awvalid),
+      .m_axi_awlock    (p_awlock),
+      .m_axi_awcache   (p_awcache),
+      .m_axi_wdata     (p_wdata),
+      .m_axi_wstrb     (p_wstrb),
+      .m_axi_wlast     (p_wlast),
+      .m_axi_wvalid    (p_wvalid),
+      .m_axi_bready    (p_bready),
+      .m_axi_arid      (p_arid),
+      .m_axi_araddr    (p_araddr),
+      .m_axi_arlen     (p_arlen),
+      .m_axi_arsize    (p_arsize),
+      .m_axi_arburst   (p_arburst),
+      .m_axi_arprot    (p_arprot),
+      .m_axi_arvalid   (p_arvalid),
+      .m_axi_arlock    (p_arlock),
+      .m_axi_arcache   (p_arcache),
+      .m_axi_rready    (p_rready)
+  );
+
+  // Link status into the main clock domain (GPIO input bit 4).
+  xpm_cdc_single #(
+      .DEST_SYNC_FF  (3),
+      .SRC_INPUT_REG (0)
+  ) i_pcie_lnk_sync (
+      .src_clk (1'b0),
+      .src_in  (pcie_lnk_up),
+      .dest_clk(clk),
+      .dest_out(pcie_lnk_up_sync)
+  );
+
+  // PCIe master after the clock converter, main clock
+  logic [3:0]   q_awid, q_arid, q_bid, q_rid;
+  logic [30:0]  q_awaddr, q_araddr;
+  logic [7:0]   q_awlen, q_arlen;
+  logic [2:0]   q_awsize, q_arsize, q_awprot, q_arprot;
+  logic [1:0]   q_awburst, q_arburst, q_bresp, q_rresp;
+  logic [0:0]   q_awlock, q_arlock;
+  logic [3:0]   q_awcache, q_arcache, q_awqos, q_arqos;
+  logic         q_awvalid, q_awready, q_wvalid, q_wready, q_wlast;
+  logic         q_bvalid, q_bready, q_arvalid, q_arready;
+  logic         q_rvalid, q_rready, q_rlast;
+  logic [255:0] q_wdata, q_rdata;
+  logic [31:0]  q_wstrb;
+
+  pcie_axi_cdc i_pcie_axi_cdc (
+      .s_axi_aclk    (pcie_aclk),
+      .s_axi_aresetn (pcie_aresetn),
+      .s_axi_awid    (p_awid),
+      .s_axi_awaddr  (p_awaddr[30:0]),
+      .s_axi_awlen   (p_awlen),
+      .s_axi_awsize  (p_awsize),
+      .s_axi_awburst (p_awburst),
+      .s_axi_awlock  (p_awlock),
+      .s_axi_awcache (p_awcache),
+      .s_axi_awprot  (p_awprot),
+      .s_axi_awregion(4'b0),
+      .s_axi_awqos   (4'b0),
+      .s_axi_awvalid (p_awvalid),
+      .s_axi_awready (p_awready),
+      .s_axi_wdata   (p_wdata),
+      .s_axi_wstrb   (p_wstrb),
+      .s_axi_wlast   (p_wlast),
+      .s_axi_wvalid  (p_wvalid),
+      .s_axi_wready  (p_wready),
+      .s_axi_bid     (p_bid),
+      .s_axi_bresp   (p_bresp),
+      .s_axi_bvalid  (p_bvalid),
+      .s_axi_bready  (p_bready),
+      .s_axi_arid    (p_arid),
+      .s_axi_araddr  (p_araddr[30:0]),
+      .s_axi_arlen   (p_arlen),
+      .s_axi_arsize  (p_arsize),
+      .s_axi_arburst (p_arburst),
+      .s_axi_arlock  (p_arlock),
+      .s_axi_arcache (p_arcache),
+      .s_axi_arprot  (p_arprot),
+      .s_axi_arregion(4'b0),
+      .s_axi_arqos   (4'b0),
+      .s_axi_arvalid (p_arvalid),
+      .s_axi_arready (p_arready),
+      .s_axi_rid     (p_rid),
+      .s_axi_rdata   (p_rdata),
+      .s_axi_rresp   (p_rresp),
+      .s_axi_rlast   (p_rlast),
+      .s_axi_rvalid  (p_rvalid),
+      .s_axi_rready  (p_rready),
+      .m_axi_aclk    (clk),
+      .m_axi_aresetn (rst_n),
+      .m_axi_awid    (q_awid),
+      .m_axi_awaddr  (q_awaddr),
+      .m_axi_awlen   (q_awlen),
+      .m_axi_awsize  (q_awsize),
+      .m_axi_awburst (q_awburst),
+      .m_axi_awlock  (q_awlock),
+      .m_axi_awcache (q_awcache),
+      .m_axi_awprot  (q_awprot),
+      .m_axi_awregion(),
+      .m_axi_awqos   (q_awqos),
+      .m_axi_awvalid (q_awvalid),
+      .m_axi_awready (q_awready),
+      .m_axi_wdata   (q_wdata),
+      .m_axi_wstrb   (q_wstrb),
+      .m_axi_wlast   (q_wlast),
+      .m_axi_wvalid  (q_wvalid),
+      .m_axi_wready  (q_wready),
+      .m_axi_bid     (q_bid),
+      .m_axi_bresp   (q_bresp),
+      .m_axi_bvalid  (q_bvalid),
+      .m_axi_bready  (q_bready),
+      .m_axi_arid    (q_arid),
+      .m_axi_araddr  (q_araddr),
+      .m_axi_arlen   (q_arlen),
+      .m_axi_arsize  (q_arsize),
+      .m_axi_arburst (q_arburst),
+      .m_axi_arlock  (q_arlock),
+      .m_axi_arcache (q_arcache),
+      .m_axi_arprot  (q_arprot),
+      .m_axi_arregion(),
+      .m_axi_arqos   (q_arqos),
+      .m_axi_arvalid (q_arvalid),
+      .m_axi_arready (q_arready),
+      .m_axi_rid     (q_rid),
+      .m_axi_rdata   (q_rdata),
+      .m_axi_rresp   (q_rresp),
+      .m_axi_rlast   (q_rlast),
+      .m_axi_rvalid  (q_rvalid),
+      .m_axi_rready  (q_rready)
+  );
+
+  // Crossbar: S00 = SoC (1-bit ID), S01 = PCIe (4-bit ID), M00 -> axi_up.
+  // Slot 0 is the low part of every concatenated vector.
+  logic [4:0]   x_awid, x_arid, x_bid, x_rid;
+  logic [30:0]  x_awaddr, x_araddr;
+  logic [7:0]   x_awlen, x_arlen;
+  logic [2:0]   x_awsize, x_arsize, x_awprot, x_arprot;
+  logic [1:0]   x_awburst, x_arburst, x_bresp, x_rresp;
+  logic [0:0]   x_awlock, x_arlock;
+  logic [3:0]   x_awcache, x_arcache, x_awqos, x_arqos, x_awregion, x_arregion;
+  logic         x_awvalid, x_awready, x_wvalid, x_wready, x_wlast;
+  logic         x_bvalid, x_bready, x_arvalid, x_arready;
+  logic         x_rvalid, x_rready, x_rlast;
+  logic [255:0] x_wdata, x_rdata;
+  logic [31:0]  x_wstrb;
+  logic [9:0]   s_bid, s_rid;
+  logic [1:0]   s_awready, s_wready, s_bvalid, s_arready, s_rvalid, s_rlast;
+  logic [3:0]   s_bresp, s_rresp;
+  logic [511:0] s_rdata;
+
+  ddr_axi_xbar i_ddr_axi_xbar (
+      .aclk          (clk),
+      .aresetn       (rst_n),
+      .s_axi_awid    ({1'b0, q_awid,    4'b0, m_awid}),
+      .s_axi_awaddr  ({q_awaddr,        m_awaddr[30:0]}),
+      .s_axi_awlen   ({q_awlen,         m_awlen}),
+      .s_axi_awsize  ({q_awsize,        m_awsize}),
+      .s_axi_awburst ({q_awburst,       m_awburst}),
+      .s_axi_awlock  ({q_awlock,        m_awlock}),
+      .s_axi_awcache ({q_awcache,       m_awcache}),
+      .s_axi_awprot  ({q_awprot,        m_awprot}),
+      .s_axi_awqos   ({q_awqos,         m_awqos}),
+      .s_axi_awvalid ({q_awvalid,       m_awvalid}),
+      .s_axi_awready (s_awready),
+      .s_axi_wdata   ({q_wdata,         m_wdata}),
+      .s_axi_wstrb   ({q_wstrb,         m_wstrb}),
+      .s_axi_wlast   ({q_wlast,         m_wlast}),
+      .s_axi_wvalid  ({q_wvalid,        m_wvalid}),
+      .s_axi_wready  (s_wready),
+      .s_axi_bid     (s_bid),
+      .s_axi_bresp   (s_bresp),
+      .s_axi_bvalid  (s_bvalid),
+      .s_axi_bready  ({q_bready,        m_bready}),
+      .s_axi_arid    ({1'b0, q_arid,    4'b0, m_arid}),
+      .s_axi_araddr  ({q_araddr,        m_araddr[30:0]}),
+      .s_axi_arlen   ({q_arlen,         m_arlen}),
+      .s_axi_arsize  ({q_arsize,        m_arsize}),
+      .s_axi_arburst ({q_arburst,       m_arburst}),
+      .s_axi_arlock  ({q_arlock,        m_arlock}),
+      .s_axi_arcache ({q_arcache,       m_arcache}),
+      .s_axi_arprot  ({q_arprot,        m_arprot}),
+      .s_axi_arqos   ({q_arqos,         m_arqos}),
+      .s_axi_arvalid ({q_arvalid,       m_arvalid}),
+      .s_axi_arready (s_arready),
+      .s_axi_rid     (s_rid),
+      .s_axi_rdata   (s_rdata),
+      .s_axi_rresp   (s_rresp),
+      .s_axi_rlast   (s_rlast),
+      .s_axi_rvalid  (s_rvalid),
+      .s_axi_rready  ({q_rready,        m_rready}),
+      .m_axi_awid    (x_awid),
+      .m_axi_awaddr  (x_awaddr),
+      .m_axi_awlen   (x_awlen),
+      .m_axi_awsize  (x_awsize),
+      .m_axi_awburst (x_awburst),
+      .m_axi_awlock  (x_awlock),
+      .m_axi_awcache (x_awcache),
+      .m_axi_awprot  (x_awprot),
+      .m_axi_awregion(x_awregion),
+      .m_axi_awqos   (x_awqos),
+      .m_axi_awvalid (x_awvalid),
+      .m_axi_awready (x_awready),
+      .m_axi_wdata   (x_wdata),
+      .m_axi_wstrb   (x_wstrb),
+      .m_axi_wlast   (x_wlast),
+      .m_axi_wvalid  (x_wvalid),
+      .m_axi_wready  (x_wready),
+      .m_axi_bid     (x_bid),
+      .m_axi_bresp   (x_bresp),
+      .m_axi_bvalid  (x_bvalid),
+      .m_axi_bready  (x_bready),
+      .m_axi_arid    (x_arid),
+      .m_axi_araddr  (x_araddr),
+      .m_axi_arlen   (x_arlen),
+      .m_axi_arsize  (x_arsize),
+      .m_axi_arburst (x_arburst),
+      .m_axi_arlock  (x_arlock),
+      .m_axi_arcache (x_arcache),
+      .m_axi_arprot  (x_arprot),
+      .m_axi_arregion(x_arregion),
+      .m_axi_arqos   (x_arqos),
+      .m_axi_arvalid (x_arvalid),
+      .m_axi_arready (x_arready),
+      .m_axi_rid     (x_rid),
+      .m_axi_rdata   (x_rdata),
+      .m_axi_rresp   (x_rresp),
+      .m_axi_rlast   (x_rlast),
+      .m_axi_rvalid  (x_rvalid),
+      .m_axi_rready  (x_rready)
+  );
+
+  // Slot 0 back to the SoC, slot 1 back to the PCIe converter.
