diff --git a/fpga/sw/vcu118/matmul_bench.c b/fpga/sw/vcu118/matmul_bench.c
new file mode 100644
index 0000000..b0b1a08
--- /dev/null
+++ b/fpga/sw/vcu118/matmul_bench.c
@@ -0,0 +1,173 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// VCU118 matmul benchmark: C = A x B, row-major, all operands in DTCM.
+//   int8 x int8 -> int32 (the usual quantized-NN inner loop)
+//   f32  x f32  -> f32
+// Each runs with RVV (broadcast A[i][k], vector of B[k][j..], multiply-add)
+// and in scalar C. Results are compared; cycles come from mcycle.
+// Last lines: "MATMUL PASS"/"MATMUL FAIL", then "DONE".
+
+#include <riscv_vector.h>
+#include <stdint.h>
+
+#include "fpga/sw/uart.h"
+
+#define M 32
+#define K 32
+#define N 32
+#define FM 16
+#define FK 16
+#define FN 16
+
+static int8_t a8[M][K], b8[K][N];
+static int32_t c_v[M][N], c_s[M][N];
+static float af[FM][FK], bf[FK][FN], cf_v[FM][FN], cf_s[FM][FN];
+
+static inline uint32_t cycles(void) {
+  uint32_t c;
+  __asm__ volatile("csrr %0, mcycle" : "=r"(c));
+  return c;
+}
+
+static void put_dec(uint32_t v) {
+  char buf[11];
+  int n = 0;
+  do {
+    buf[n++] = (char)('0' + v % 10);
+    v /= 10;
+  } while (v);
+  while (n) uart_putc(buf[--n]);
+}
+
+// x100 fixed point, e.g. 1234 -> "12.34"
+static void put_fix2(uint32_t v100) {
+  put_dec(v100 / 100);
+  uart_putc('.');
+  uart_putc((char)('0' + (v100 / 10) % 10));
+  uart_putc((char)('0' + v100 % 10));
+}
+
+static void report(const char* name, int ok, uint32_t macs, uint32_t vc,
+                   uint32_t sc) {
+  uart_puts("  ");
+  uart_puts(name);
+  uart_puts(ok ? "  ok" : "  FAIL");
+  uart_puts("  vector ");
+  put_dec(vc);
+  uart_puts(" cyc (");
+  put_fix2(macs * 100u / vc);
+  uart_puts(" MAC/cyc, ");
+  put_fix2(macs * 5000u / vc);  // 50 MHz
+  uart_puts(" MMAC/s)  scalar ");
+  put_dec(sc);
+  uart_puts(" cyc  speedup ");
+  put_fix2(sc * 100u / vc);
+  uart_puts("x\r\n");
+}
+
+static void mm_i8_rvv(void) {
+  for (int i = 0; i < M; ++i) {
+    for (size_t j = 0, n = N; n > 0;) {
+      size_t vl = __riscv_vsetvl_e32m4(n);
+      vint32m4_t acc = __riscv_vmv_v_x_i32m4(0, vl);
+      for (int k = 0; k < K; ++k) {
+        vint8m1_t b = __riscv_vle8_v_i8m1(&b8[k][j], vl);
+        vint32m4_t bw = __riscv_vsext_vf4_i32m4(b, vl);
+        acc = __riscv_vmacc_vx_i32m4(acc, a8[i][k], bw, vl);
+      }
+      __riscv_vse32_v_i32m4(&c_v[i][j], acc, vl);
+      n -= vl;
+      j += vl;
+    }
+  }
+}
+
+static void mm_i8_scalar(void) {
+  for (int i = 0; i < M; ++i)
+    for (int j = 0; j < N; ++j) {
+      int32_t acc = 0;
+      for (int k = 0; k < K; ++k) acc += (int32_t)a8[i][k] * b8[k][j];
+      c_s[i][j] = acc;
+    }
+}
+
+static void mm_f32_rvv(void) {
+  for (int i = 0; i < FM; ++i) {
+    for (size_t j = 0, n = FN; n > 0;) {
+      size_t vl = __riscv_vsetvl_e32m4(n);
+      vfloat32m4_t acc = __riscv_vfmv_v_f_f32m4(0.0f, vl);
+      for (int k = 0; k < FK; ++k) {
+        vfloat32m4_t b = __riscv_vle32_v_f32m4(&bf[k][j], vl);
+        acc = __riscv_vfmacc_vf_f32m4(acc, af[i][k], b, vl);
+      }
+      __riscv_vse32_v_f32m4(&cf_v[i][j], acc, vl);
+      n -= vl;
+      j += vl;
+    }
+  }
+}
+
+static void mm_f32_scalar(void) {
+  for (int i = 0; i < FM; ++i)
+    for (int j = 0; j < FN; ++j) {
+      float acc = 0.0f;
+      for (int k = 0; k < FK; ++k) acc += af[i][k] * bf[k][j];
+      cf_s[i][j] = acc;
+    }
+}
+
