From 5f8760ebbff0a6349a1d63c7053120601ac6a0ec Mon Sep 17 00:00:00 2001
From: SOTA-PNU <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 17:02:23 +0900
Subject: [PATCH] fpga/vcu118: matrix-unit (VME) smoke test for the matrix
 bitstreams

---
 fpga/BUILD                 |   6 ++
 fpga/sw/vcu118/vme_test.cc | 214 +++++++++++++++++++++++++++++++++++++
 2 files changed, 220 insertions(+)
 create mode 100644 fpga/sw/vcu118/vme_test.cc

diff --git a/fpga/BUILD b/fpga/BUILD
index 5a85795..ff30b10 100644
--- a/fpga/BUILD
+++ b/fpga/BUILD
@@ -981,6 +981,12 @@ coralnpu_v2_binary(
     deps = [":uart"],
 )
 
+coralnpu_v2_binary(
+    name = "vcu118_vme_test",
+    srcs = ["sw/vcu118/vme_test.cc"],
+    deps = [":uart"],
+)
+
 VCU118_VIVADO_HOOKS = [
     "vcu118_setup_hooks.tcl",
     "vcu118_pre_opt_hooks.tcl",
diff --git a/fpga/sw/vcu118/vme_test.cc b/fpga/sw/vcu118/vme_test.cc
new file mode 100644
index 0000000..70460f9
--- /dev/null
+++ b/fpga/sw/vcu118/vme_test.cc
@@ -0,0 +1,214 @@
