From 7d5b111ac2fdc2e4628e6afbf2a6bac3899fd9e4 Mon Sep 17 00:00:00 2001
From: donghun <ehdgns1083@pusan.ac.kr>
Date: Mon, 2 Nov 2026 08:50:06 +0900
Subject: [PATCH] fpga/vcu118: release the DDR4 controller from a power-on
 reset, not EOS

On the board the SoC GPIO input reads 0x0: bit 1 (controller out of reset)
never goes high, so calibration never starts. Everything else on that path
checked out -- the .xci gives SYSTEM_RESET POLARITY = ACTIVE_HIGH for
sys_rst, cpu_reset is an active-high button that idles low (the SoC runs
off ~cpu_reset and passes its regression), and the probe's pin check puts
c0_sys_clk_p on E12 with every one of the 118 ports placed. With cpu_reset
low, sys_rst = cpu_reset | ~eos reduces to ~eos, so STARTUPE3's EOS is the
only term left that can hold the controller down.

Drive sys_rst from a counter on the main clock instead, whose heartbeat on
LED 1 proves it runs: hold for 65535 cycles (~1.3 ms at 50 MHz), then
release. The button still forces a reset.

This also makes the next run conclusive either way. EOS moves to GPIO input
bit 2 and the power-on reset itself to bit 3, so the loader can say whether
EOS was ever rising; and if bit 1 is still 0 once bit 3 has dropped, the
250 MHz reference clock is not reaching the IP and nothing on the reset
path is to blame.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VA1TWrEgAQBMFJS9SyVgUy
---
 fpga/rtl/chip_vcu118.sv | 35 ++++++++++++++++++++++++++++++++---
 1 file changed, 32 insertions(+), 3 deletions(-)

diff --git a/fpga/rtl/chip_vcu118.sv b/fpga/rtl/chip_vcu118.sv
index 04e3ba3..c1e3a3a 100644
--- a/fpga/rtl/chip_vcu118.sv
+++ b/fpga/rtl/chip_vcu118.sv
@@ -42,6 +42,7 @@
 //           [6] on when the controller is out of reset (ui_clk_sync_rst low)
 //           [7] on when calibration is complete
 //   * GPIO inputs: [0] calibration complete [1] controller out of reset
+//                  [2] STARTUPE3 EOS   [3] DDR4 power-on reset still held
 module chip_vcu118 #(
     parameter MemInitFile = "",
     parameter int ClockFrequencyMhz = 50,
@@ -113,7 +114,7 @@ module chip_vcu118 #(
   // ------------------------------------------------------------------
   logic [7:0] gpio_out, gpio_en;
   logic io_halted, io_fault;
-  logic ddr_calib, ddr_calib_sync, ddr_run_sync;
+  logic ddr_calib, ddr_calib_sync, ddr_run_sync, eos_sync;
   logic ui_clk, ui_rst;
   // MIG debug clock, wired to the Vivado debug hub in pins_vcu118.xdc so the
   // hardware manager can show the calibration stages (as the MIG example
@@ -129,6 +130,22 @@ module chip_vcu118 #(
     else heartbeat_q <= heartbeat_q + 1'b1;
   end
 
+  // DDR4 controller power-on reset. sys_rst used to be cpu_reset | ~eos,
+  // which holds the controller in reset forever if STARTUPE3's EOS never
+  // rises -- and on the board GPIO bit 1 (controller out of reset) stays 0
+  // while sys_rst is correctly ACTIVE_HIGH and cpu_reset idles low, so ~eos
+  // is the only term left that can be holding it. Count on the main clock
+  // instead, whose heartbeat on LED 1 proves it is running: hold sys_rst for
+  // 65535 cycles (~1.3 ms at 50 MHz), then release it for good. If the
+  // controller still does not come out of reset after this, the 250 MHz
+  // reference clock is not reaching the IP.
+  logic [15:0] ddr_por_q = '0;
+  logic        ddr_por_rst;
+  always_ff @(posedge clk) begin
+    if (!(&ddr_por_q)) ddr_por_q <= ddr_por_q + 1'b1;
+  end
+  assign ddr_por_rst = !(&ddr_por_q);
+
   assign led[0]   = locked;
   assign led[1]   = heartbeat_q[24];
   assign led[2]   = io_halted;
@@ -223,8 +240,20 @@ module chip_vcu118 #(
       .USRDONETS(1'b1)
   );
 
+  // EOS into the main clock domain (GPIO input bit 2). Nothing depends on it
+  // any more; it is here only to answer whether EOS was ever rising.
+  xpm_cdc_single #(
+      .DEST_SYNC_FF  (3),
+      .SRC_INPUT_REG (0)
+  ) i_eos_sync (
+      .src_clk (1'b0),
+      .src_in  (eos),
+      .dest_clk(clk),
+      .dest_out(eos_sync)
+  );
+
   ddr4_c1 i_ddr4 (
-      .sys_rst                (cpu_reset | ~eos),
+      .sys_rst                (cpu_reset | ddr_por_rst),
       .c0_sys_clk_p           (c0_sys_clk_p),
       .c0_sys_clk_n           (c0_sys_clk_n),
       .c0_init_calib_complete (ddr_calib),
@@ -467,7 +496,7 @@ module chip_vcu118 #(
       .spim_flash_rst_no(),
       .gpio_o           (gpio_out),
       .gpio_en_o        (gpio_en),
-      .gpio_i           ({6'h00, ddr_run_sync, ddr_calib_sync}),
+      .gpio_i           ({4'h0, ddr_por_rst, eos_sync, ddr_run_sync, ddr_calib_sync}),
       // Camera / ISP: no sensor on this board
       .ISP_DVP_D0       (1'b0),
       .ISP_DVP_D1       (1'b0),
