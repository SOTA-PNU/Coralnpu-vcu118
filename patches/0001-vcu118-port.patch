index 0000000..8e63996
--- /dev/null
+++ b/fpga/sw/vcu118/rom_park.c
@@ -0,0 +1,54 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// VCU118 boot ROM: say hello on the console, then park.
+//
+// The VCU118 has no SPI-flash loader wired up, so this ROM does not try to
+// boot anything. It proves that clock, reset, the core and UART1 work, and
+// then spins in a tight loop that the debugger can halt. After halting,
+// OpenOCD/GDB loads a program into ITCM/DTCM and resumes at its entry point.
+
+#include <stdint.h>
+
+#include "fpga/sw/clk.h"
+#include "fpga/sw/gpio.h"
+#include "fpga/sw/uart.h"
+
+static void uart_putdec(uint32_t v) {
+  char buf[11];
+  int n = 0;
+  do {
+    buf[n++] = (char)('0' + v % 10);
+    v /= 10;
+  } while (v != 0);
+  while (n > 0) uart_putc(buf[--n]);
+}
+
+int main(void) {
+  uart_init();
+  uart_puts("\r\nCoralNPU on VCU118: ROM alive, main clock ");
+  uart_putdec(clk_get_main_freq_mhz());
+  uart_puts(" MHz\r\nParked. Attach the debugger (OpenOCD) to load a program.\r\n");
+
+  // Walk a bit across LED[7:4] so "core is executing" is visible on the board.
+  gpio_set_output_enable(0xF);
+  uint32_t pattern = 1;
+  while (1) {
+    gpio_write(pattern);
+    pattern = (pattern << 1) & 0xF;
+    if (pattern == 0) pattern = 1;
+    for (volatile uint32_t i = 0; i < 2000000; ++i) {
+    }
+  }
+}
diff --git a/fpga/vcu118/README.md b/fpga/vcu118/README.md
new file mode 100644
index 0000000..6e202d8
--- /dev/null
+++ b/fpga/vcu118/README.md
@@ -0,0 +1,63 @@
+# CoralNPU on VCU118
+
+`chip_nexus`(Google 사내 보드, xcvu13p)를 VCU118(xcvu9p-flga2104-2L-e)로 옮긴 것.
+프로그램 적재와 디버그는 **FPGA 자체 JTAG(BSCANE2)** 로 한다. 추가 케이블 없음.
+
+## 무엇이 들어 있나
+
+| 파일 | 역할 |
+|---|---|
+| `rtl/chip_vcu118.sv` | 탑. 125 MHz 클럭, CPU_RESET, UART1 → USB-UART, LED 8개, DDR 미연결 |
+| `rtl/clkgen_vcu118.sv` | 125 MHz → VCO 1000 MHz → main 50 / SPIM 100 / ISP 10 MHz |
+| `rtl/dmi_jtag_bscane.sv`, `rtl/dmi_bscane_tap.sv` | pulp riscv-dbg 의 BSCANE2 판 DTM (모듈 이름만 바꾼 사본) |
+| `pins_vcu118.xdc` | 핀. AMD 보드 파일(XilinxBoardStore vcu118/2.4) 값과 대조 완료 |
+| `chip_vcu118.core` | FuseSoC 코어 (part = xcvu9p-flga2104-2L-e) |
+| `vcu118_setup_hooks.tcl`, `vcu118_pre_opt_hooks.tcl` | Nexus 훅에서 pblock·SLR3 지정을 뺀 것 (VU9P 는 SLR0~2 뿐) |
+| `sw/vcu118/rom_park.c` | 부트 ROM: UART 배너 출력 후 대기 (디버거가 멈추고 프로그램을 올림) |
+| `sw/vcu118/hello.c` | JTAG 으로 올리는 첫 프로그램 |
+| `vcu118/gen_openocd_cfg.sh` | Vivado 의 BSDL 에서 IR 길이·USER3/USER4 코드를 읽어 OpenOCD 설정 생성 |
+| `vcu118/load_elf.sh` | ELF 를 ITCM/DTCM 에 올리고 실행 |
+
+LED: `[0]` MMCM lock · `[1]` 하트비트(클럭만 있으면 깜빡임) · `[2]` halted · `[3]` fault ·
+`[7:4]` ROM 이 돌리는 GPIO 패턴(코어가 명령을 실행 중이라는 뜻).
+
+## 빌드 (Linux, Vivado 가 PATH 에 있어야 함)
+
+```bash
+source /tools/Xilinx/Vivado/2026.1/settings64.sh   # 설치 경로에 맞게
+bazel build //fpga:build_chip_vcu118_synth_only_vector_normal   # 합성만 → LUT 확인
+bazel build //fpga:build_chip_vcu118_bitstream_vector_normal    # 비트스트림
+bazel build //fpga:vcu118_hello                                 # 첫 ELF
+```
+
+`vector_highmem`(ITCM/DTCM 각 1 MB) 판도 같은 이름 규칙으로 있다. DDR 이 없으므로
+큰 프로그램은 highmem 판을 쓴다.
+
+## 보드에서
+
+1. USB 두 개: **J106**(JTAG, Digilent JTAG-SMT2-NC) 과 **J4**(UART, CP2105).
+2. UART 터미널 115200 8N1. CP2105 는 포트가 두 개 생긴다 — 배너가 나오는 쪽이 FPGA 쪽.
+3. Vivado Hardware Manager 로 `.bit` 다운로드. 즉시 UART 에:
+   ```
+   CoralNPU on VCU118: ROM alive, main clock 50 MHz
+   Parked. Attach the debugger (OpenOCD) to load a program.
+   ```
+4. **Hardware Manager 를 닫는다** (hw_server 와 OpenOCD 는 USB-JTAG 을 동시에 못 쓴다).
+5. ```bash
+   fpga/vcu118/gen_openocd_cfg.sh > openocd_vcu118.cfg     # 한 번만
+   fpga/vcu118/load_elf.sh openocd_vcu118.cfg bazel-bin/fpga/vcu118_hello.elf
+   ```
+   UART 에 `Hello from CoralNPU on VCU118 (loaded over JTAG)` … `DONE`.
+
+GDB 로 붙으려면 `openocd -f openocd_vcu118.cfg` 를 띄워 두고 `target extended-remote :3333`.
+
+## 알려진 한계
+
+- **DDR4 없음.** `0x8000_0000` 이상을 건드리면 버스가 멈춘다(상류 ddr4_stub 과 같은 동작).
+  CPU_RESET 버튼으로 풀린다.
+- SPI 로더·SPI 플래시·I2C·카메라 미연결.
+- `gen_openocd_cfg.sh` 의 BSDL 파서는 Xilinx BSDL 형식을 가정한다. 파싱 실패 시 멈추고
+  이유를 출력한다 — 값을 짐작해서 넣지 말 것 (공개 표에 VU9P IR 길이가 24 로 적힌 곳이
+  있으나 VU9P 는 3-SLR 이므로 18 이 맞을 가능성이 높다. BSDL 이 정답).
+- 아직 실제 Vivado 합성·보드 실행 전이다. 검증된 것은 Verilator lint, 핀 대조,
+  MMCM 분주 계산, OpenOCD 설정 파싱까지.
diff --git a/fpga/vcu118/gen_openocd_cfg.sh b/fpga/vcu118/gen_openocd_cfg.sh
new file mode 100755
index 0000000..5a27b5b
--- /dev/null
+++ b/fpga/vcu118/gen_openocd_cfg.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+# Copyright 2026 Google LLC
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#      http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+#
+# Generate the OpenOCD config for chip_vcu118 from the XCVU9P BSDL file that
+# ships with Vivado.
+#
+# Why generate instead of hard-coding: the debug transport sits behind the
+# FPGA's BSCANE2 USER3 (DTMCS) / USER4 (DMI) instructions. On stacked-silicon
+# parts (VU9P = 3 SLRs) the instruction register is the concatenation of every
+# SLR's IR, so the USER3/USER4 opcodes are long and part-specific. Published
+# tables disagree on the VU9P values, so we read them from AMD's own BSDL.
+#
+# Usage: gen_openocd_cfg.sh [path/to/xcvu9p*.bsd] > openocd_vcu118.cfg
+set -euo pipefail
+
+BSD="${1:-}"
+if [[ -z "${BSD}" ]]; then
+  : "${XILINX_VIVADO:?set XILINX_VIVADO (source settings64.sh) or pass the .bsd path}"
+  BSD="$(find "${XILINX_VIVADO}/data/parts" -iname 'xcvu9p*flga2104*.bsd' 2>/dev/null | head -n1)"
+fi
+[[ -f "${BSD}" ]] || { echo "BSDL file not found: '${BSD}'" >&2; exit 1; }
+
+irlen="$(grep -iE 'attribute[[:space:]]+INSTRUCTION_LENGTH' "${BSD}" | grep -oE '[0-9]+' | tail -n1)"
+# Opcode lines look like:  "USER3  (100010100100100100)," & -- possibly with X's
+opcode() {
+  local name="$1"
+  grep -iE "\"?[[:space:]]*${name}[[:space:]]*\(" "${BSD}" | head -n1 |
+    sed -E "s/.*${name}[[:space:]]*\(([01Xx, ]+)\).*/\1/I" | cut -d, -f1 | tr -d ' ' | tr 'Xx' '00'
+}
+user3="$(opcode USER3)"
+user4="$(opcode USER4)"
+idcode="$(opcode IDCODE)"
+for v in irlen user3 user4 idcode; do
+  [[ -n "${!v}" ]] || { echo "could not parse ${v} from ${BSD}" >&2; exit 1; }
+done
+if [[ "${#user3}" -ne "${irlen}" ]]; then
+  echo "opcode width ${#user3} != INSTRUCTION_LENGTH ${irlen}; check ${BSD}" >&2
+  exit 1
+fi
+hex() { printf '0x%x' "$((2#$1))"; }
+
+cat <<CFG
+# Generated by fpga/vcu118/gen_openocd_cfg.sh from:
+#   $(basename "${BSD}")
+# IR length ${irlen}, USER3=${user3}, USER4=${user4}
+
+adapter speed 10000
+source [find interface/ftdi/digilent_jtag_smt2_nc.cfg]
+transport select jtag
+
+set _CHIPNAME vu9p
+jtag newtap \$_CHIPNAME tap -irlen ${irlen}
+
+set _TARGETNAME \$_CHIPNAME.cpu
+target create \$_TARGETNAME riscv -chain-position \$_CHIPNAME.tap
+
+# The RISC-V DTM lives behind BSCANE2 USER3 (dtmcs) and USER4 (dmi).
+riscv set_ir idcode $(hex "${idcode}")
+riscv set_ir dtmcs  $(hex "${user3}")
+riscv set_ir dmi    $(hex "${user4}")
+
+# Same memory access mode as the upstream Verilator setup (jtag-sim.cfg).
+riscv set_mem_access abstract
+gdb_breakpoint_override hard
+
+init
+halt
+CFG
diff --git a/fpga/vcu118/load_elf.sh b/fpga/vcu118/load_elf.sh
new file mode 100755
index 0000000..37ef7cb
--- /dev/null
+++ b/fpga/vcu118/load_elf.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+# Copyright 2026 Google LLC
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#      http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+#
+# Load an ELF into the running chip_vcu118 over JTAG and start it.
+#   load_elf.sh openocd_vcu118.cfg path/to/program.elf
+# The park ROM must be running (banner on the UART). Vivado Hardware Manager
+# must be closed first: OpenOCD and hw_server cannot share the USB-JTAG.
+set -euo pipefail
+cfg="$1"; elf="$2"
+entry="$(readelf -h "${elf}" | awk '/Entry point address/ {print $4}')"
+exec openocd -f "${cfg}" \
+  -c "load_image ${elf}" \
+  -c "verify_image ${elf}" \
+  -c "resume ${entry}" \
+  -c "shutdown"
diff --git a/fpga/vcu118_pre_opt_hooks.tcl b/fpga/vcu118_pre_opt_hooks.tcl
new file mode 100644
index 0000000..1f447af
--- /dev/null
+++ b/fpga/vcu118_pre_opt_hooks.tcl
@@ -0,0 +1,37 @@
+# Copyright 2026 Google LLC
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     https://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# Pre-opt hook for chip_vcu118.
+#
+# The Nexus hook (vivado_pre_opt_hooks.tcl) cannot be reused as-is:
+#   * it sources pblock_u_isp.tcl / pblock_u_ddr.tcl, which place the camera
+#     ISP and the DDR4 MIG at Nexus-specific sites (no MIG in this build);
+#   * it pins the TCMs to SLR3. The VU13P has 4 SLRs, the VU9P only 3
+#     (SLR0..SLR2), so SLR3 does not exist here.
+# Everything else is the same generic tuning.
+
+set script_dir [file dirname [file normalize [info script]]]
+source "${script_dir}/check_pin_assignments.tcl"
+
+catch {
+    set sram_cells [get_cells -quiet -hierarchical -filter {PRIMITIVE_SUBGROUP == ram && (NAME =~ *SRAM* || NAME =~ *sram* || NAME =~ *tcm*)}]
+    if {[llength $sram_cells] > 0} {
+        set_property RAM_STYLE ultra $sram_cells
+        puts "INFO: Enforced RAM_STYLE ultra on [llength $sram_cells] SRAM cells."
+    }
+}
+
+catch { set_property MUXF_REMAP 1 [get_cells -hierarchical -filter {REF_NAME =~ MUXF* && NAME =~ *score/lsu*}] }
+catch { set_property MAX_FANOUT 256 [get_cells -hierarchical -filter {NAME =~ *score/lsu/rs/deqPtr_reg*}] }
+catch { set_property MAX_FANOUT 256 [get_cells -hierarchical -filter {NAME =~ *div_clk_rst_r1_reg*}] }
