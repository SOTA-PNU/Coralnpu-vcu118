+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# VCU118 (xcvu9p-flga2104-2L-e) pin constraints for chip_vcu118.
+#
+# Every LOC / IOSTANDARD below is taken from the AMD board file
+# XilinxBoardStore boards/Xilinx/vcu118/2.4/part0_pins.xml and board.xml
+# (branch 2024.1), the same data Vivado uses when you pick the VCU118 board.
+
+## 125 MHz system clock (SYSCLK_125_P/N, LVDS)
+set_property -dict { PACKAGE_PIN AY24 IOSTANDARD LVDS } [get_ports sysclk_125_p]
+set_property -dict { PACKAGE_PIN AY23 IOSTANDARD LVDS } [get_ports sysclk_125_n]
+create_clock -period 8.000 -name sysclk_125 [get_ports sysclk_125_p]
+
+## CPU_RESET push button (active high)
+set_property -dict { PACKAGE_PIN L19 IOSTANDARD LVCMOS12 } [get_ports cpu_reset]
+set_false_path -from [get_ports cpu_reset]
+
+## USB-UART (Silicon Labs CP2105). Directions per board.xml rs232_uart:
+##   TxD (FPGA out) -> USB_UART_TX, RxD (FPGA in) <- USB_UART_RX
+set_property -dict { PACKAGE_PIN BB21 IOSTANDARD LVCMOS18 } [get_ports uart_txd]
+set_property -dict { PACKAGE_PIN AW25 IOSTANDARD LVCMOS18 } [get_ports uart_rxd]
+set_false_path -to   [get_ports uart_txd]
+set_false_path -from [get_ports uart_rxd]
+
+## User LEDs GPIO_LED_0..7 (active high)
+set_property -dict { PACKAGE_PIN AT32 IOSTANDARD LVCMOS12 DRIVE 8 } [get_ports {led[0]}]
+set_property -dict { PACKAGE_PIN AV34 IOSTANDARD LVCMOS12 DRIVE 8 } [get_ports {led[1]}]
+set_property -dict { PACKAGE_PIN AY30 IOSTANDARD LVCMOS12 DRIVE 8 } [get_ports {led[2]}]
+set_property -dict { PACKAGE_PIN BB32 IOSTANDARD LVCMOS12 DRIVE 8 } [get_ports {led[3]}]
+set_property -dict { PACKAGE_PIN BF32 IOSTANDARD LVCMOS12 DRIVE 8 } [get_ports {led[4]}]
+set_property -dict { PACKAGE_PIN AU37 IOSTANDARD LVCMOS12 DRIVE 8 } [get_ports {led[5]}]
+set_property -dict { PACKAGE_PIN AV36 IOSTANDARD LVCMOS12 DRIVE 8 } [get_ports {led[6]}]
+set_property -dict { PACKAGE_PIN BA37 IOSTANDARD LVCMOS12 DRIVE 8 } [get_ports {led[7]}]
+set_false_path -to [get_ports {led[*]}]
+
+## JTAG debug clock from BSCANE2 (the FPGA's TCK). The DMI CDC (dmi_cdc)
+## synchronises between TCK and the core clock, so the domains are async.
+## OpenOCD on the on-board JTAG runs well below 30 MHz; 33.3 ns is a safe bound.
+create_clock -period 33.333 -name jtag_tck [get_pins -hierarchical -filter {NAME =~ *i_tap_dtmcs/TCK}]
+
+set_clock_groups -asynchronous \
+  -group [get_clocks -include_generated_clocks sysclk_125] \
+  -group [get_clocks jtag_tck]
+
+## Bitstream settings
+set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
diff --git a/fpga/rtl/chip_vcu118.sv b/fpga/rtl/chip_vcu118.sv
new file mode 100644
index 0000000..6fc8200
--- /dev/null
+++ b/fpga/rtl/chip_vcu118.sv
@@ -0,0 +1,294 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// CoralNPU SoC top-level for the AMD/Xilinx VCU118 (xcvu9p-flga2104-2L-e).
+//
+// Derived from chip_nexus.sv. Differences:
+//   * Clock: 125 MHz LVDS SYSCLK (AY24/AY23) through clkgen_vcu118.
+//   * Reset: CPU_RESET push button (L19), active HIGH on this board.
+//   * Debug: RISC-V debug transport over the FPGA's own JTAG port via BSCANE2
+//            (USER3 = DTMCS, USER4 = DMI). No extra pins or cables: OpenOCD
+//            talks to the same USB-JTAG used to load the bitstream.
+//   * UART:  the software console is UART1 (0x4001_0000, see fpga/sw/uart.c),
+//            so UART1 goes to the on-board CP2105 USB-UART. UART0 is unused.
+//   * DDR4:  not connected yet. The SoC's DDR AXI ports are tied off exactly
+//            like fpga/ip/ddr4_stub (never ready), so any access to
+//            0x8000_0000.. hangs the bus. Do not touch DDR on this build.
+//   * SPI device / SPI host / SPI flash / I2C / camera: not connected.
+//   * LEDs: [0] MMCM locked [1] heartbeat [2] io_halted [3] io_fault
+//           [7:4] SoC GPIO[3:0]
+module chip_vcu118 #(
+    parameter MemInitFile = "",
+    parameter int ClockFrequencyMhz = 50,
+    parameter int IspClockFrequencyMhz = 10,
+    parameter int SpimClockFrequencyMhz = 100,
+    parameter int EnableAutoboot = 0,
+    parameter int ItcmSizeKBytes = 8,
+    parameter int DtcmSizeKBytes = 32,
+    parameter int AddrWidth = 32,
+    parameter logic [AddrWidth-1:0] BootAddr = 0
+) (
+    input  logic       sysclk_125_p,
+    input  logic       sysclk_125_n,
+    input  logic       cpu_reset,     // active high push button
+    output logic       uart_txd,      // FPGA -> CP2105 (USB_UART_TX)
+    input  logic       uart_rxd,      // CP2105 -> FPGA (USB_UART_RX)
+    output logic [7:0] led
+);
+
+  // ------------------------------------------------------------------
+  // Clocks and reset
+  // ------------------------------------------------------------------
+  logic clk, clk_isp, clk_spim;
+  logic rst_n, locked;
+
+  clkgen_vcu118 #(
+      .ClockFrequencyMhz(ClockFrequencyMhz)
+  ) i_clkgen (
+      .clk_p_i   (sysclk_125_p),
+      .clk_n_i   (sysclk_125_n),
+      .rst_ni    (~cpu_reset),
+      .clk_main_o(clk),
+      .clk_isp_o (clk_isp),
+      .clk_spim_o(clk_spim),
+      .rst_no    (rst_n),
+      .locked_o  (locked)
+  );
+
+  // ------------------------------------------------------------------
+  // UART: console on UART1
+  // ------------------------------------------------------------------
+  top_pkg::uart_sideband_i_t [1:0] uart_sideband_i;
+  top_pkg::uart_sideband_o_t [1:0] uart_sideband_o;
+
+  assign uart_sideband_i[0].cio_rx = 1'b1;  // idle
+  assign uart_sideband_i[1].cio_rx = uart_rxd;
+  assign uart_txd = uart_sideband_o[1].cio_tx;
+
+  // ------------------------------------------------------------------
+  // GPIO / status LEDs
+  // ------------------------------------------------------------------
+  logic [7:0] gpio_out, gpio_en;
+  logic io_halted, io_fault;
+
+  // ~1.5 Hz at 50 MHz: proves the main clock is alive without any software.
+  logic [24:0] heartbeat_q;
+  always_ff @(posedge clk or negedge rst_n) begin
+    if (!rst_n) heartbeat_q <= '0;
+    else heartbeat_q <= heartbeat_q + 1'b1;
+  end
+
+  assign led[0]   = locked;
+  assign led[1]   = heartbeat_q[24];
+  assign led[2]   = io_halted;
+  assign led[3]   = io_fault;
+  assign led[7:4] = gpio_out[3:0] & gpio_en[3:0];
+
+  // ------------------------------------------------------------------
+  // RISC-V debug transport over BSCANE2
+  // ------------------------------------------------------------------
+  logic dm_req_valid, dm_req_ready;
+  dm::dmi_req_t dm_req;
+  logic dm_rsp_valid, dm_rsp_ready;
+  dm::dmi_resp_t dm_rsp;
+
+  dmi_jtag_bscane #(
+      // Not visible on the wire: with BSCANE2 the FPGA's own IDCODE is used.
+      .IdcodeValue(32'h04f5484d)
+  ) i_dmi_jtag (
+      .clk_i           (clk),
+      .rst_ni          (rst_n),
+      .testmode_i      (1'b0),
+      .test_rst_ni     (1'b1),
+      .dmi_rst_no      (),
+      .dmi_req_o       (dm_req),
+      .dmi_req_valid_o (dm_req_valid),
+      .dmi_req_ready_i (dm_req_ready),
+      .dmi_resp_i      (dm_rsp),
+      .dmi_resp_ready_o(dm_rsp_ready),
+      .dmi_resp_valid_i(dm_rsp_valid),
+      .tck_i           (1'b0),
+      .tms_i           (1'b0),
+      .trst_ni         (1'b1),
+      .td_i            (1'b0),
+      .td_o            (),
+      .tdo_oe_o        ()
+  );
+
+  // ------------------------------------------------------------------
+  // DDR AXI tie-off (same behaviour as fpga/ip/ddr4_stub: never ready)
+  // ------------------------------------------------------------------
+  logic ddr_ctrl_aw_valid, ddr_ctrl_w_valid, ddr_ctrl_ar_valid;
+  logic ddr_mem_aw_valid, ddr_mem_w_valid, ddr_mem_ar_valid;
+
+  // ------------------------------------------------------------------
+  // SoC
+  // ------------------------------------------------------------------
+  coralnpu_soc #(
+      .MemInitFile          (MemInitFile),
+      .ClockFrequencyMhz    (ClockFrequencyMhz),
+      .IspClockFrequencyMhz (IspClockFrequencyMhz),
+      .SpimClockFrequencyMhz(SpimClockFrequencyMhz),
+      .EnableAutoboot       (EnableAutoboot),
+      .ItcmSizeKBytes       (ItcmSizeKBytes),
+      .DtcmSizeKBytes       (DtcmSizeKBytes),
+      .AddrWidth            (AddrWidth)
+  ) i_coralnpu_soc (
+      .clk_i            (clk),
+      .clk_isp_i        (clk_isp),
+      .rst_ni           (rst_n),
+      // SPI device (host loader on Nexus): idle
+      .spi_clk_i        (1'b0),
+      .spi_csb_i        (1'b1),
+      .spi_mosi_i       (1'b0),
+      .spi_miso_o       (),
+      // SPI host: unconnected
+      .spim_sclk_o      (),
+      .spim_csb_o       (),
+      .spim_mosi_o      (),
+      .spim_miso_i      (1'b0),
+      .spim_clk_i       (clk_spim),
+      .boot_addr_i      (BootAddr),
+      // SPI flash: unconnected
