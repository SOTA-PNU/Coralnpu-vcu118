+
+// First program loaded through the JTAG debug port on the VCU118.
+
+#include <stdint.h>
+
+#include "fpga/sw/uart.h"
+
+int main(void) {
+  uart_init();
+  uart_puts("Hello from CoralNPU on VCU118 (loaded over JTAG)\r\n");
+  for (uint32_t i = 0; i < 5; ++i) {
+    uart_puts("  count = ");
+    uart_puthex32(i);
+    uart_puts("\r\n");
+  }
+  uart_puts("DONE\r\n");
+  return 0;
+}
diff --git a/fpga/sw/vcu118/rom_park.c b/fpga/sw/vcu118/rom_park.c
