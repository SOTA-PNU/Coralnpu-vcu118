diff --git a/fpga/BUILD b/fpga/BUILD
index ef82ce5..cf2fe30 100644
--- a/fpga/BUILD
+++ b/fpga/BUILD
@@ -912,3 +912,123 @@ genrule(
 )
 
 collect_coralnpu_elfs()
+
+# -----------------------------------------------------------------------------
+# VCU118 (xcvu9p-flga2104-2L-e)
+#
+# Debug transport goes over the FPGA's own JTAG (BSCANE2), so the board needs
+# no extra cable. The SoC boots a small ROM (sw/vcu118/rom_park.c) that prints
+# a banner on the USB-UART and parks; programs are then loaded with OpenOCD.
+# DDR4 is not connected in this build (see rtl/chip_vcu118.sv).
+#
+#   bazel build //fpga:build_chip_vcu118_synth_only_vector_normal   # LUT count
+#   bazel build //fpga:build_chip_vcu118_bitstream_vector_normal    # .bit
+#   bazel build //fpga:vcu118_hello                                 # first ELF
+# -----------------------------------------------------------------------------
+
+coralnpu_v2_binary(
+    name = "vcu118_rom_park",
+    srcs = ["sw/vcu118/rom_park.c"],
+    crt = ":rom_boot_crt0",
+    linker_script = "sw/rom_boot/rom.ld",
+    deps = [
+        ":clk",
+        ":gpio",
+        ":uart",
+    ],
+)
+
+coralnpu_v2_binary(
+    name = "vcu118_rom_park_highmem",
+    srcs = ["sw/vcu118/rom_park.c"],
+    crt = ":rom_boot_crt0",
+    linker_script = "sw/rom_boot/rom_highmem.ld",
+    deps = [
+        ":clk",
+        ":gpio",
+        ":uart",
+    ],
+)
+
+filegroup(
+    name = "vcu118_rom_park_vmem",
+    srcs = [":vcu118_rom_park"],
+    output_group = "vmem_file",
+)
+
+filegroup(
+    name = "vcu118_rom_park_highmem_vmem",
+    srcs = [":vcu118_rom_park_highmem"],
+    output_group = "vmem_file",
+)
+
+coralnpu_v2_binary(
+    name = "vcu118_hello",
+    srcs = ["sw/vcu118/hello.c"],
+    deps = [":uart"],
+)
+
+VCU118_VIVADO_HOOKS = [
+    "vcu118_setup_hooks.tcl",
+    "vcu118_pre_opt_hooks.tcl",
+    "check_pin_assignments.tcl",
+    "vivado_post_place_hooks.tcl",
+    "vivado_post_route_hooks.tcl",
+]
+
+VCU118_COMMON_SRCS = CORALNPU_SOC_SRCS_COMMON + [
+    "pins_vcu118.xdc",
+] + VCU118_VIVADO_HOOKS
+
+VCU118_COMMON_CORES = [
+    ":chip_vcu118.core",
+    "//fpga/ip/i2c_master:i2c_master.core",
+    "//fpga/ip/ispyocto:ispyocto_core",
+]
+
+# Only the vector (no VME) variants: they are the ones sized for a VU9P.
+_VCU118_CONFIGS = [
+    dict(c, park_vmem = ":vcu118_rom_park_vmem", park_vmem_file = "$(location :vcu118_rom_park_vmem)")
+    for c in _ALL_CONFIGS
+    if c["name"] == "vector_normal"
+] + [
+    dict(c, park_vmem = ":vcu118_rom_park_highmem_vmem", park_vmem_file = "$(location :vcu118_rom_park_highmem_vmem)")
+    for c in _ALL_CONFIGS
+    if c["name"] == "vector_highmem"
+]
+
+_VCU118_NAME_MAP = {
+    "build_chip_vcu118_" + build_type + c["suffix"]: {
+        "cores": CORALNPU_SOC_CORES_COMMON + VCU118_COMMON_CORES + [c["chisel_core"]],
+        "srcs": VCU118_COMMON_SRCS + [c["chisel_rtl"], c["park_vmem"]],
+        "flags": [
+            "--ClockFrequencyMhz=" + c["clock_frequency_mhz"],
+            "--IspClockFrequencyMhz=" + _ISP_CLOCK_FREQUENCY_MHZ,
+            "--SpimClockFrequencyMhz=" + _SPIM_CLOCK_FREQUENCY_MHZ,
+            "--ItcmSizeKBytes=" + c["itcm"],
+            "--DtcmSizeKBytes=" + c["dtcm"],
+            # Boot the park ROM; the autoboot FSM releases the core's clock
+            # gate and reset at power-up, so no host write is needed.
+            "--EnableAutoboot=1",
+            "--MemInitFile=" + c["park_vmem_file"],
+            "--BootAddr=268435456",
+        ] + (["--pnr=none"] if build_type in ("synth_only", "elab_only") else []),
+        "target": "elab" if build_type == "elab_only" else "synth",
+    }
+    for c in _VCU118_CONFIGS
+    for build_type in [
+        "bitstream",
+        "synth_only",
+        "elab_only",
+    ]
+}
+
+template_rule(
+    fusesoc_build,
+    _VCU118_NAME_MAP,
+    output_groups = {
+        "all": ["com.google.coralnpu_fpga_chip_vcu118_0.1/"],
+    },
+    systems = ["com.google.coralnpu:fpga:chip_vcu118:0.1"],
+    tags = ["manual"],
+)
